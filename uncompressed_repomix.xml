import React,{useCallback,useEffect,useState} from 'react';
import {ActivityIndicator,Alert,RefreshControl,ScrollView,Text,TouchableOpacity,View} from 'react-native';
import {SafeAreaView} from 'react-native-safe-area-context';
import {router} from 'expo-router';
import {ArrowLeft,MapPin,PackageCheck,Timer} from 'lucide-react-native';
import {callFunction} from '../services/functions';

type Offer={offerId:string;jobId:string;category:string;serviceType:string;price:number;estimatedPayout:number;estimatedDuration:number;suppliesRequired:boolean;suppliesFee:number;distanceKm:number|null;expiresAt:string;checklist?:unknown};

export default function InstantOffersScreen(){
  const [offers,setOffers]=useState<Offer[]>([]);const [loading,setLoading]=useState(true);const [busy,setBusy]=useState('');
  const load=useCallback(async()=>{try{const result=await callFunction<{}, {offers:Offer[]}>('listInstantOffers',{});setOffers(result.offers);}catch(error:any){Alert.alert('Could not load offers',error.message||'Try again shortly.');}finally{setLoading(false);}},[]);
  useEffect(()=>{load();const timer=setInterval(load,10000);return()=>clearInterval(timer);},[load]);
  const respond=async(offer:Offer,accept:boolean)=>{setBusy(offer.offerId);try{const result=await callFunction('respondInstantOffer',{offerId:offer.offerId,accept,idempotencyKey:`instant-${offer.offerId}-${accept?'accept':'decline'}`});setOffers(current=>current.filter(item=>item.offerId!==offer.offerId));if(result?.status==='CUSTOMER_ACTION_REQUIRED')Alert.alert('Offer sent','The customer has been notified and will review the price and payment method.');}catch(error:any){Alert.alert('Offer unavailable',error.message||'This offer may have expired.');await load();}finally{setBusy('');}};
  return <SafeAreaView className="flex-1 bg-[#F3F1FC]"><View className="flex-row items-center gap-3 px-5 py-4 bg-white"><TouchableOpacity onPress={()=>router.back()} className="w-10 h-10 bg-ink/5 rounded-2xl items-center justify-center"><ArrowLeft size={18} color="#150256"/></TouchableOpacity><View><Text className="text-xl font-display font-black text-ink">Instant offers</Text><Text className="font-sans text-xs text-ink/50">Nearby requests expire after three minutes</Text></View></View>
    <ScrollView className="flex-1 px-5 pt-4" refreshControl={<RefreshControl refreshing={loading} onRefresh={load}/>}>{loading&&offers.length===0?<ActivityIndicator color="#3906D2"/>:offers.length===0?<View className="bg-white rounded-3xl p-6 items-center"><Text className="font-display font-black text-ink">No nearby offers</Text><Text className="font-sans text-sm text-ink/50 text-center mt-2">Go online and keep location sharing enabled to receive instant bookings.</Text></View>:offers.map(offer=><View key={offer.offerId} className="bg-white rounded-3xl border border-ink/10 p-5 mb-4"><Text className="text-lg font-display font-black text-ink">{offer.serviceType}</Text><Text className="font-sans text-xs text-ink/50 mt-1">{offer.category==='HOUSE'?'House cleaning':'Car cleaning'} · about {offer.estimatedDuration} minutes</Text><View className="flex-row gap-4 mt-4"><View className="flex-row items-center gap-1"><MapPin size={14} color="#3906D2"/><Text className="font-sans text-xs text-ink">{offer.distanceKm===null?'Nearby':`${offer.distanceKm} km away`}</Text></View><View className="flex-row items-center gap-1"><Timer size={14} color="#3906D2"/><Text className="font-sans text-xs text-ink">{Math.max(0,Math.ceil((Date.parse(offer.expiresAt)-Date.now())/1000))} sec left</Text></View></View>{offer.suppliesRequired&&<View className="flex-row items-center gap-2 mt-3"><PackageCheck size={14} color="#3906D2"/><Text className="font-sans text-xs text-ink">Bring supplies · ${Number(offer.suppliesFee).toFixed(2)} added</Text></View>}<View className="mt-4 p-4 rounded-2xl bg-accent/5"><Text className="font-sans text-sm text-ink">Customer price: ${Number(offer.price).toFixed(2)}</Text><Text className="font-display font-black text-accent mt-1">Estimated cleaner payout: ${Number(offer.estimatedPayout).toFixed(2)}</Text></View><View className="flex-row gap-3 mt-4"><TouchableOpacity disabled={!!busy} onPress={()=>respond(offer,false)} className="flex-1 rounded-xl bg-ink/5 p-3 items-center"><Text className="font-display font-black text-ink">Decline</Text></TouchableOpacity><TouchableOpacity disabled={!!busy} onPress={()=>respond(offer,true)} className="flex-1 rounded-xl bg-accent p-3 items-center"><Text className="font-display font-black text-white">{busy===offer.offerId?'Sending…':'Accept job'}</Text></TouchableOpacity></View></View>)}</ScrollView></SafeAreaView>;
}
