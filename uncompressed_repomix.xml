import React, { useEffect, useState } from 'react';
import { Search, ShieldAlert } from 'lucide-react';
import { adminCall, mutateAdmin } from './api';

type ModuleKey = 'bookings'|'customers'|'cleaners'|'payments'|'products'|'analytics'|'support';
const configs: Record<ModuleKey, {title:string; subtitle:string; filters:string[]; actions:string[]; columns:string[]}> = {
  bookings:{title:'Bookings',subtitle:'Server-paginated booking operations and lifecycle history',filters:['Status','Service','Date'],actions:['Create booking','Reschedule','Assign / reassign','Change status','Cancel'],columns:['Booking','Customer','Cleaner','Service','Scheduled','Status','Payment']},
  customers:{title:'Customers',subtitle:'Profiles, spend, addresses, notes, ratings and support history',filters:['Account state','Upcoming'],actions:['Add internal note','Change account state'],columns:['Customer','Contact','State','Bookings','Total spend','Upcoming']},
  cleaners:{title:'Cleaners / Staff',subtitle:'Verification, availability, coverage, performance and commission',filters:['Status','Verification','Service','Coverage'],actions:['Invite cleaner','Deactivate'],columns:['Cleaner','Verification','Coverage','Availability','Assignments','Rating','Earnings']},
  payments:{title:'Payments / Refunds',subtitle:'Processor-authoritative captures, failures and immutable refund events',filters:['Status','Date','Type'],actions:['Full refund','Partial refund','Retry refund','Resolve no-show'],columns:['Payment','Booking','Customer','Captured','Refunded','Processor ref','Status']},
  products:{title:'After-sales Products',subtitle:'Catalog, cleaner inventory, attributed sales and commission',filters:['Cleaner','Product','Date','Status'],actions:['Add product','Adjust inventory','Generate sales QR'],columns:['Product / Sale','Cleaner','Inventory','Sold','Commission','Status']},
  analytics:{title:'Analytics',subtitle:'Operational Firestore aggregates are shown separately from behavioral PostHog insights',filters:['Period','Service','Cleaner'],actions:['Export aggregate'],columns:['Metric','Source','Current','Previous','Change','Health']},
  support:{title:'Support Cases',subtitle:'No-shows, cancellations, low ratings and manual resolution',filters:['Status','Reason','Owner'],actions:['Resolve case','Issue refund'],columns:['Case','Booking','Reason','Opened','Owner','Status']},
};

export function DataModule({ kind, focusId }: {kind:ModuleKey; focusId?:string}) {
  const cfg=configs[kind], [result,setResult]=useState<any>({rows:[],nextCursor:null}), [loading,setLoading]=useState(true), [error,setError]=useState(''), [search,setSearch]=useState(focusId||''), [filters,setFilters]=useState<Record<string,string>>({});
  const [payouts,setPayouts]=useState<any[]>([]);
  const load=(cursor?:string)=>{setLoading(true);setError('');Promise.all([adminCall<any>('adminQuery',{module:kind,search,filters,cursor,pageSize:25}),...(kind==='payments'?[adminCall<any>('listPayoutRequests')]:[])]).then(([data,payoutData])=>{setResult(data);if(payoutData)setPayouts(payoutData.requests||[])}).catch(e=>setError(e.message)).finally(()=>setLoading(false));};
  useEffect(()=>load(),[kind]);
  const action=async(label:string,row?:any)=>{const targetId=row?.id||focusId; if(!targetId){setError('Select a specific record before applying this action.');return;}let extra:Record<string,unknown>={};
    if(label==='Reschedule'){const scheduledDateTime=window.prompt('New booking date and time (ISO format, e.g. 2026-11-10T10:00:00+02:00)');if(!scheduledDateTime)return;extra.scheduledDateTime=scheduledDateTime;}
    if(label==='Assign / reassign'){const cleanerId=window.prompt('Cleaner account ID to assign');if(!cleanerId)return;extra.cleanerId=cleanerId;}
    if(label==='Request refund'){const amount=window.prompt('Refund amount in USD (issue it in the Paynow portal after recording this request)');if(!amount)return;extra.amount=Number(amount);}
    if(label==='Resolve case'){extra.resolution=window.prompt('Resolution notes')||'';}
    if(label==='Change account state'){extra.state=window.confirm('Suspend this account? Choose Cancel to reactivate.')?'SUSPENDED':'ACTIVE';}
    const reason=window.prompt(`${label}: enter the operational reason`);if(!reason)return;if(!window.confirm(`Confirm ${label} for ${targetId}? This action is audited.`))return;
    const actionNames:Record<string,string>={'Cancel':'cancel_booking','Reschedule':'reschedule_booking','Assign / reassign':'reassign_booking','Change account state':'change_account_state','Deactivate':'deactivate_cleaner','Request refund':'request_refund','Resolve case':'resolve_case','Add internal note':'add_internal_note'};
    try{await mutateAdmin(actionNames[label]||label.toLowerCase().replaceAll(' ','_'),{module:kind,reason,idempotencyKey:crypto.randomUUID(),targetId,...extra});load();}catch(e:any){setError(e.message)}};
  const rowActions:Record<ModuleKey,string[]>={bookings:['Reschedule','Assign / reassign','Cancel'],customers:['Change account state'],cleaners:['Deactivate'],payments:['Request refund'],products:[],analytics:[],support:['Resolve case']};
  return <section><header className="module-header"><div><h1>{cfg.title}</h1><p>{cfg.subtitle}</p></div></header>{kind==='payments'&&<article className="panel"><h2>Cleaner payout queue</h2><p>Two administrators are required: one approves; another reveals the encrypted destination and records the completed transfer.</p>{payouts.length===0?<p>No pending payout requests.</p>:payouts.map((p:any)=><div key={p.id} className="payout-row"><span><b>${Number(p.amount).toFixed(2)} · {p.method} · {p.status}</b><br/>{p.accountNumberMasked}<br/>Cleaner {p.cleanerid}</span>{p.status==='PENDING'?<button onClick={async()=>{if(!window.confirm('Approve this payout for a second administrator to settle?'))return;try{await adminCall('settlePayoutRequest',{payoutRequestId:p.id,decision:'APPROVED'});load()}catch(e:any){setError(e.message)}}}>Approve</button>:<><button onClick={async()=>{try{const destination=await adminCall<any>('revealPayoutDestination',{payoutRequestId:p.id});window.alert(`Pay ${destination.accountName} at ${destination.accountNumber}`);const transferReference=window.prompt('Enter the transfer receipt/reference after paying');if(!transferReference)return;await adminCall('settlePayoutRequest',{payoutRequestId:p.id,decision:'PAID',transferReference});load()}catch(e:any){setError(e.message)}}}>Reveal and mark paid</button><button onClick={async()=>{if(!window.confirm('Reject this approved payout and return reserved funds?'))return;try{await adminCall('settlePayoutRequest',{payoutRequestId:p.id,decision:'REJECTED'});load()}catch(e:any){setError(e.message)}}}>Reject</button></>}</div>)}</article>}<div className="toolbar"><label><Search size={15}/><input value={search} onChange={e=>setSearch(e.target.value)} onKeyDown={e=>e.key==='Enter'&&load()} placeholder="Search ID, customer or cleaner"/></label>{cfg.filters.map(f=><select aria-label={f} key={f} value={filters[f]||''} onChange={e=>setFilters({...filters,[f]:e.target.value})}><option value="">All {f.toLowerCase()}</option><option>Active</option><option>Pending</option><option>Completed</option><option>Cancelled</option></select>)}<button onClick={()=>load()}>Apply</button></div>{error&&<div className="inline-error"><ShieldAlert size={16}/>{error}</div>}<div className="table-wrap"><table><thead><tr>{cfg.columns.map(c=><th key={c}>{c}</th>)}{rowActions[kind].length>0&&<th>Actions</th>}</tr></thead><tbody>{loading?<tr><td colSpan={cfg.columns.length+1}>Loading server results…</td></tr>:result.rows.length===0?<tr><td colSpan={cfg.columns.length+1}>No matching records.</td></tr>:result.rows.map((r:any)=><tr key={r.id}>{cfg.columns.map(c=><td key={c}>{String(r[c]??r[c.toLowerCase()]??'—')}</td>)}{rowActions[kind].length>0&&<td>{rowActions[kind].map(label=><button className="row-action" key={label} onClick={()=>action(label,r)}>{label}</button>)}</td>}</tr>)}</tbody></table></div><div className="pager"><span>Up to 25 authoritative records per page</span><button disabled={!result.nextCursor} onClick={()=>load(result.nextCursor)}>Next page</button></div></section>;
}
</file>

