import React, { useEffect, useState } from 'react';
import { Download, Printer, Search, ShieldAlert } from 'lucide-react';
import { adminCall, mutateAdmin } from './api';

type ModuleKey = 'bookings'|'customers'|'cleaners'|'payments'|'products'|'analytics'|'support';
const configs: Record<ModuleKey, {title:string; subtitle:string; filters:string[]; actions:string[]; columns:string[]}> = {
  bookings:{title:'Bookings',subtitle:'Server-paginated booking operations and lifecycle history',filters:['Status','Service','Date'],actions:['Create booking','Reschedule','Assign / reassign','Change status','Cancel'],columns:['Booking','Customer','Cleaner','Service','Scheduled','Status','Payment']},
  customers:{title:'Customers',subtitle:'Profiles, spend, addresses, notes, ratings and support history',filters:['Account state','Upcoming'],actions:['Add internal note','Change account state'],columns:['Customer','Contact','State','Bookings','Total spend','Upcoming']},
  cleaners:{title:'Cleaners / Staff',subtitle:'Verification, availability, coverage, performance and commission',filters:['Status','Verification','Service','Coverage'],actions:['Invite cleaner','Deactivate'],columns:['Cleaner','Verification','Coverage','Availability','Assignments','Rating','Earnings']},
  payments:{title:'Payments / Refunds',subtitle:'Processor-authoritative captures, failures and immutable refund events',filters:['Status','Date','Type'],actions:['Full refund','Partial refund','Retry refund','Resolve no-show'],columns:['Payment','Booking','Customer','Captured','Refunded','Processor ref','Status']},
  products:{title:'After-sales Products',subtitle:'Catalog, cleaner inventory, attributed sales and commission',filters:['Cleaner','Product','Date','Status'],actions:['Add product','Adjust inventory','Generate sales QR'],columns:['Product / Sale','Cleaner','Inventory','Sold','Commission','Status']},
  analytics:{title:'Analytics',subtitle:'Operational Firestore aggregates are shown separately from behavioral PostHog insights',filters:['Period','Service','Cleaner'],actions:['Export aggregate'],columns:['Metric','Source','Current','Previous','Change','Health']},
  support:{title:'Support Cases',subtitle:'No-shows, cancellations, low ratings and manual resolution',filters:['Status','Reason','Owner'],actions:['Resolve case','Issue refund'],columns:['Case','Booking','Reason','Opened','Owner','Status']},
};

export function DataModule({ kind, focusId }: {kind:ModuleKey; focusId?:string}) {
  const cfg=configs[kind], [result,setResult]=useState<any>({rows:[],nextCursor:null}), [loading,setLoading]=useState(true), [error,setError]=useState(''), [search,setSearch]=useState(focusId||''), [filters,setFilters]=useState<Record<string,string>>({});
  const load=(cursor?:string)=>{setLoading(true);setError('');adminCall<any>('adminQuery',{module:kind,search,filters,cursor,pageSize:25}).then(setResult).catch(e=>setError(e.message)).finally(()=>setLoading(false));};
  useEffect(()=>load(),[kind]);
  const action=async(label:string)=>{const reason=window.prompt(`${label}: enter the required operational reason`);if(!reason)return;if(!window.confirm(`Confirm ${label}? This action is audited and cannot be hidden.`))return;try{await mutateAdmin(label.toLowerCase().replaceAll(' ','_'),{module:kind,reason,idempotencyKey:crypto.randomUUID(),targetId:focusId||result.rows[0]?.id||null});load();}catch(e:any){setError(e.message)}};
  return <section><header className="module-header"><div><h1>{cfg.title}</h1><p>{cfg.subtitle}</p></div></header><div className="toolbar"><label><Search size={15}/><input value={search} onChange={e=>setSearch(e.target.value)} onKeyDown={e=>e.key==='Enter'&&load()} placeholder="Search ID, customer or cleaner"/></label>{cfg.filters.map(f=><select aria-label={f} key={f} value={filters[f]||''} onChange={e=>setFilters({...filters,[f]:e.target.value})}><option value="">All {f.toLowerCase()}</option><option>Active</option><option>Pending</option><option>Completed</option><option>Cancelled</option></select>)}<button onClick={()=>load()}>Apply</button></div><div className="action-strip">{cfg.actions.map(a=><button key={a} onClick={()=>action(a)}>{a}</button>)}</div>{error&&<div className="inline-error"><ShieldAlert size={16}/>{error}</div>}<div className="table-wrap"><table><thead><tr>{cfg.columns.map(c=><th key={c}>{c}</th>)}</tr></thead><tbody>{loading?<tr><td colSpan={cfg.columns.length}>Loading server results…</td></tr>:result.rows.length===0?<tr><td colSpan={cfg.columns.length}>No matching records.</td></tr>:result.rows.map((r:any)=><tr key={r.id}>{cfg.columns.map(c=><td key={c}>{String(r[c]??r[c.toLowerCase()]??'—')}</td>)}</tr>)}</tbody></table></div><div className="pager"><span>Up to 25 authoritative records per page</span><button disabled={!result.nextCursor} onClick={()=>load(result.nextCursor)}>Next page</button></div>{kind==='products'&&<article className="panel qr-info"><h2>Cleaner sales links</h2><p>QR payloads contain a short-lived signed opaque token—not a cleaner UID. Generated codes use high error correction so the centered Detail mark remains scannable.</p><button onClick={()=>action('Generate sales QR')}><Download size={15}/> Download</button><button onClick={()=>window.print()}><Printer size={15}/> Print</button></article>}</section>;
}
</file>

