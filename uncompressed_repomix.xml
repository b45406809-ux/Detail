  cleanerOnboardingComplete?: boolean;
  cleanerAgreementAccepted?: boolean;
  serviceCategories?: ServiceCategory[];
  serviceRadiusKm?: number;
  experienceYears?: number;
  address?: string;
  serviceArea?: string;
  proofOfResidenceUrl?: string;
