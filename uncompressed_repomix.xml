<file path="storage.rules">
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuth() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function underSizeLimit() {
      return request.resource.size < 10 * 1024 * 1024; // 10 MB
    }

    // Booking photos ("Add Photos" step) — uploaded by the customer before a
    // cleanerId even exists, so any signed-in user may read (cleaners need to
    // see them to bid) but only the uploader's own uid segment is writable.
    match /job-photos/{uid}/{allPaths=**} {
      allow read: if isAuth();
      allow write: if isAuth() && request.auth.uid == uid && isImage() && underSizeLimit();
    }

    // Chat attachments, scoped per job. Any authenticated participant can
    // read; write is allowed for any signed-in user since job membership is
    // enforced by the Firestore `messages` rule the client writes through.
    match /chat-photos/{jobId}/{allPaths=**} {
      allow read: if isAuth();
      allow write: if isAuth() && isImage() && underSizeLimit();
    }

    // Profile photos.
    match /profile-photos/{uid}/{allPaths=**} {
      allow read: if isAuth();
      allow write: if isAuth() && request.auth.uid == uid && isImage() && underSizeLimit();
    }

    // Proof-of-residence photos captured during cleaner registration
    // (register-cleaner.tsx). Sensitive PII — unlike profile-photos, only
    // the owner can ever read their own upload back; Detail staff review it
    // via the Admin SDK (bypasses rules), not through this path.
    match /verification/{uid}/{allPaths=**} {
      allow read: if isAuth() && request.auth.uid == uid;
      allow write: if isAuth() && request.auth.uid == uid && isImage() && underSizeLimit();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
</file>

<file path=".github/workflows/deploy.yml">
name: Build and deploy site and dashboard

on:
  push:
    branches: [main]
  workflow_dispatch:

concurrency:
  group: production-cpanel
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  deploy:
    runs-on: ubuntu-latest
    environment: production
    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Create D1 waitlist database and deploy API Worker
        id: waitlist
        env:
          CLOUDFLARE_ACCOUNT_ID: ${{ vars.CLOUDFLARE_ACCOUNT_ID }}
          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          TURNSTILE_SECRET: ${{ secrets.TURNSTILE_SECRET }}
          RESEND_API_KEY: ${{ secrets.RESEND_API_KEY }}
          INITIAL_ADMIN_EMAIL: ${{ vars.INITIAL_ADMIN_EMAIL || 'crzzphillip@gmail.com' }}
          INITIAL_ADMIN_PASSWORD: ${{ secrets.INITIAL_ADMIN_PASSWORD }}
          WAITLIST_ALLOWED_ORIGINS: https://detailapp.co.zw,https://www.detailapp.co.zw,https://dashboard.detailapp.co.zw
        run: python3 scripts/deploy-cloudflare-waitlist.py

      - name: Verify Cloudflare API before building either site
        env:
          WAITLIST_API_URL: ${{ steps.waitlist.outputs.api_url }}
        run: |
          test -n "$WAITLIST_API_URL"
          curl --fail --silent --show-error --retry 5 --retry-all-errors \
            --retry-delay 3 "$WAITLIST_API_URL/health" | grep -q '"storage":"cloudflare-d1"'
          curl --fail --silent --show-error --request OPTIONS \
            --header 'Origin: https://detailapp.co.zw' \
            --header 'Access-Control-Request-Method: POST' \
            --dump-header /tmp/waitlist-cors.txt --output /dev/null \
            "$WAITLIST_API_URL/api/waitlist"
          grep -qi '^access-control-allow-origin: https://detailapp.co.zw' /tmp/waitlist-cors.txt

      - name: Install site dependencies
        run: npm ci --prefix site --no-audit --no-fund

      - name: Type-check and build production SPA
        run: npm run build
        env:
          VITE_POSTHOG_KEY: ${{ secrets.VITE_POSTHOG_KEY }}
          VITE_POSTHOG_HOST: ${{ vars.VITE_POSTHOG_HOST }}
          VITE_TURNSTILE_SITE_KEY: ${{ secrets.VITE_TURNSTILE_SITE_KEY }}
          VITE_WAITLIST_API_URL: ${{ steps.waitlist.outputs.api_url }}

      - name: Verify Apache routing file is in the artifact
        run: test -f site/dist/.htaccess

      - name: Deploy main site over explicit FTPS
        uses: SamKirkland/FTP-Deploy-Action@v4.3.5
        with:
          server: ${{ secrets.FTP_SERVER }}
          username: ${{ secrets.FTP_USERNAME }}
          password: ${{ secrets.FTP_PASSWORD }}
          protocol: ftps
          port: 21
          local-dir: site/dist/
          server-dir: public_html/
          exclude: |
            **/.git*
            **/.git*/**

      - name: Deploy dashboard subdomain artifact over explicit FTPS
        uses: SamKirkland/FTP-Deploy-Action@v4.3.5
        with:
          server: ${{ secrets.FTP_SERVER }}
          username: ${{ secrets.FTP_USERNAME }}
          password: ${{ secrets.FTP_PASSWORD }}
          protocol: ftps
          port: 21
          local-dir: site/dist/
          server-dir: public_html/dashboard/
          exclude: |
            **/.git*
            **/.git*/**
</file>

