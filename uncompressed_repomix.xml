import React, { useState, useRef, useEffect, useCallback } from 'react';
import {
  View,
  Text,
  TextInput,
  TouchableOpacity,
  KeyboardAvoidingView,
  Platform,
  ActivityIndicator,
  Alert,
} from 'react-native';
import { router, useLocalSearchParams } from 'expo-router';
import { SafeAreaView } from 'react-native-safe-area-context';
import { ArrowLeft } from 'lucide-react-native';
import { IS_MOCK } from '../../utils/env';
import { sendPhoneOTP, confirmPhoneOTP } from '../../services/phoneAuth';
import { GlassCard } from '../../components/glass';

const OTP_LENGTH = 6;

export default function VerifyScreen() {
  const { phone, displayPhone } = useLocalSearchParams<{ phone: string; displayPhone?: string }>();
  const [otp, setOtp] = useState<string[]>(Array(OTP_LENGTH).fill(''));
  const [isVerifying, setIsVerifying] = useState(false);
  const [isSending, setIsSending] = useState(false);
  const [resendTimer, setResendTimer] = useState(60);
  const inputRefs = useRef<(TextInput | null)[]>([]);

  const sendCode = useCallback(async () => {
    if (isSending || !phone) return;
    setIsSending(true);
    try {
      const normalizedPhone = phone.startsWith('+') ? phone : `+${phone}`;
      await sendPhoneOTP(normalizedPhone);
      setResendTimer(60);
    } catch (err: any) {
      Alert.alert('Failed to Send Code', err.message ?? 'Please try again.');
    } finally {
      setIsSending(false);
    }
  }, [phone, isSending]);

  useEffect(() => {
    sendCode();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  useEffect(() => {
    const id = setInterval(() => setResendTimer((t) => (t > 0 ? t - 1 : 0)), 1000);
    return () => clearInterval(id);
  }, []);

  const handleOtpChange = (value: string, index: number) => {
    const newOtp = [...otp];
    newOtp[index] = value.slice(-1);
    setOtp(newOtp);

    if (value && index < OTP_LENGTH - 1) {
      inputRefs.current[index + 1]?.focus();
    }

    if (newOtp.every((d) => d !== '') && newOtp.join('').length === OTP_LENGTH) {
      handleVerify(newOtp.join(''));
    }
  };

  const handleKeyPress = (e: any, index: number) => {
    if (e.nativeEvent.key === 'Backspace' && !otp[index] && index > 0) {
      inputRefs.current[index - 1]?.focus();
    }
  };

  const handleVerify = async (code: string) => {
    setIsVerifying(true);
    try {
      await confirmPhoneOTP(code);
      router.replace('/(auth)/create-profile');
    } catch (err: any) {
      const msg = err.message?.toLowerCase().includes('session')
        ? 'Your session expired. Tap "Resend Code" to get a new one.'
        : 'The code you entered is incorrect. Please try again.';
      Alert.alert('Verification Failed', msg);
      setOtp(Array(OTP_LENGTH).fill(''));
      inputRefs.current[0]?.focus();
    } finally {
      setIsVerifying(false);
    }
  };

  const handleResend = () => {
    setOtp(Array(OTP_LENGTH).fill(''));
    sendCode();
  };

  const isComplete = otp.every((d) => d !== '');

  return (
    <SafeAreaView className="flex-1 bg-white">
      <KeyboardAvoidingView className="flex-1 px-6 pt-6" behavior={Platform.OS === 'ios' ? 'padding' : 'height'}>
        <TouchableOpacity
          onPress={() => router.back()}
          className="w-12 h-12 bg-white rounded-2xl items-center justify-center mb-8 border border-ink/10"
        >
          <ArrowLeft size={20} color="#150256" />
        </TouchableOpacity>

        <Text className="text-3xl font-black text-ink tracking-tight mb-2">Enter the code</Text>
        <Text className="text-base text-ink/50 font-medium mb-10">
          {IS_MOCK ? 'DEV mode — enter any 6 digits to continue' : `We sent a 6-digit code to\n`}
          {!IS_MOCK && <Text className="text-ink font-black">{displayPhone || phone}</Text>}
        </Text>

        {isSending && (
          <View className="flex-row items-center gap-2 mb-6">
            <ActivityIndicator size="small" color="#3906D2" />
            <Text className="text-sm text-ink/40 font-medium">Sending code…</Text>
          </View>
        )}

        <GlassCard style={{ paddingVertical: 24, paddingHorizontal: 16 }}>
          <View className="flex-row gap-3 justify-center">
            {otp.map((digit, index) => (
              <TextInput
                key={index}
                ref={(ref) => {
                  inputRefs.current[index] = ref;
                }}
                className="w-12 h-14 rounded-2xl text-center text-xl font-black text-ink"
                style={{
                  backgroundColor: digit ? 'rgba(57,6,210,0.12)' : 'rgba(15,11,46,0.03)',
                  borderWidth: 2,
                  borderColor: digit ? '#3906D2' : 'rgba(15,11,46,0.1)',
                }}
                keyboardType="number-pad"
                maxLength={1}
                value={digit}
                onChangeText={(v) => handleOtpChange(v, index)}
                onKeyPress={(e) => handleKeyPress(e, index)}
                autoFocus={index === 0}
                editable={!isVerifying}
              />
            ))}
          </View>
        </GlassCard>

        <TouchableOpacity
          onPress={() => handleVerify(otp.join(''))}
          disabled={isVerifying || !isComplete || isSending}
          activeOpacity={0.85}
          className="w-full py-5 rounded-[28px] items-center mt-8"
          style={{ backgroundColor: isComplete && !isSending ? '#3906D2' : 'rgba(15,11,46,0.08)' }}
        >
          {isVerifying ? (
            <ActivityIndicator color="#fff" />
          ) : (
            <Text
              className="font-black text-sm uppercase tracking-widest"
              style={{ color: isComplete && !isSending ? '#fff' : 'rgba(15,11,46,0.3)' }}
            >
              Verify Code
            </Text>
          )}
        </TouchableOpacity>

        <View className="flex-row items-center justify-center mt-6">
          <Text className="text-sm text-ink/40 font-medium">Didn't receive it? </Text>
          {resendTimer > 0 ? (
            <Text className="text-sm font-black text-ink/25">Resend in {resendTimer}s</Text>
          ) : (
            <TouchableOpacity onPress={handleResend} disabled={isSending}>
              <Text className="text-sm font-black text-accent">Resend Code</Text>
            </TouchableOpacity>
          )}
        </View>
      </KeyboardAvoidingView>
    </SafeAreaView>
  );
}
</file>

<file path="mobile/app/(tabs)/profile.tsx">
import React, { useEffect, useState } from 'react';
import {
  View,
  Text,
  TouchableOpacity,
  ScrollView,
  Switch,
  Alert,
  Image,
  ActivityIndicator,
} from 'react-native';
import { SafeAreaView } from 'react-native-safe-area-context';
import { router } from 'expo-router';
import {
  User,
  ChevronRight,
  History,
  Shield,
  Bell,
  LogOut,
  Star,
  Briefcase,
  HelpCircle,
  FileText,
  Heart,
  Repeat,
  Camera,
} from 'lucide-react-native';
import * as ImagePicker from 'expo-image-picker';
import * as Notifications from 'expo-notifications';
import { Linking } from 'react-native';
import { useAuth } from '../../context/AuthContext';
import { auth, signOut } from '../../services/supabase';
import { callFunction } from '../../services/functions';
import { uploadProfilePhoto } from '../../services/storage';
import { getExpoPushToken } from '../../services/notifications';
import { StarRating } from '../../components/StarRating';

export default function ProfileScreen() {
  const { user, profile, updateProfile } = useAuth();
  const [notificationsOn, setNotificationsOn] = useState(true);
  const [isUploadingPhoto, setIsUploadingPhoto] = useState(false);
  useEffect(() => { setNotificationsOn(!!profile?.expoPushToken); }, [profile?.expoPushToken]);

  const setPushNotifications = async (enabled: boolean) => {
    if (!enabled) {
      try { await updateProfile({ expoPushToken: '' }); setNotificationsOn(false); }
      catch { Alert.alert('Could not update notification settings', 'Please try again.'); }
      return;
    }
    const permission = await Notifications.requestPermissionsAsync();
    if (!permission.granted) { Alert.alert('Allow notifications', 'Enable notifications in your device settings to receive booking and payment updates.'); return; }
    const token = await getExpoPushToken();
    if (!token) { Alert.alert('Notifications unavailable', 'This device could not register for push notifications right now.'); return; }
    try { await updateProfile({ expoPushToken: token }); setNotificationsOn(true); }
    catch { Alert.alert('Could not enable notifications', 'Please try again.'); }
  };

  const handlePickProfilePhoto = async () => {
    Alert.alert('Update Profile Picture', 'Choose how you would like to set your photo', [
      {
        text: 'Take Photo',
        onPress: () => pickImage(true),
      },
      {
        text: 'Choose from Gallery',
        onPress: () => pickImage(false),
      },
      ...(profile?.photoURL
        ? [
            {
              text: 'Remove Photo',
              style: 'destructive' as const,
              onPress: async () => {
                try {
                  await updateProfile({ photoURL: '' });
                } catch {
                  Alert.alert('Error', 'Failed to remove photo.');
                }
              },
            },
          ]
        : []),
      { text: 'Cancel', style: 'cancel' },
    ]);
  };

  const pickImage = async (fromCamera: boolean) => {
    try {
      const permission = fromCamera
        ? await ImagePicker.requestCameraPermissionsAsync()
        : await ImagePicker.requestMediaLibraryPermissionsAsync();
      if (!permission.granted) {
        Alert.alert('Permission needed', 'Please allow camera/photo access to update your profile picture.');
        return;
      }
      const result = fromCamera
        ? await ImagePicker.launchCameraAsync({
            allowsEditing: true,
            aspect: [1, 1],
            quality: 0.8,
          })
        : await ImagePicker.launchImageLibraryAsync({
            allowsEditing: true,
            aspect: [1, 1],
            quality: 0.8,
          });

      if (result.canceled || !result.assets?.[0]?.uri) return;

      setIsUploadingPhoto(true);
      const photoUrl = await uploadProfilePhoto(result.assets[0].uri);
      await updateProfile({ photoURL: photoUrl });
    } catch {
      Alert.alert('Upload failed', 'Could not upload profile picture. Please try again.');
    } finally {
      setIsUploadingPhoto(false);
    }
  };

  // Uber-style mode switch. Going CUSTOMER -> CLEANER is gated: the cleaner
  // registration form (register-cleaner.tsx) and the Cleaner Agreement
  // acceptance must both be done first. Once done, switching back and forth
  // is instant. Going CLEANER -> CUSTOMER never needs a gate.
  const handleSwitchRole = () => {
    if (profile?.role === 'CUSTOMER') {
      if (profile.cleanerOnboardingComplete && profile.hasAgreedToTerms) {
        updateProfile({ role: 'CLEANER' });
      } else {
        router.push('/register-cleaner');
      }
    } else if (profile?.role === 'CLEANER') {
      updateProfile({ role: 'CUSTOMER' });
    }
  };

  const handleDeleteAccount = () => {
    Alert.alert('Delete account?', 'You must have signed in recently. Active bookings or unresolved payments must be completed first. This cannot be undone.', [
      { text: 'Keep account', style: 'cancel' },
      { text: 'Delete permanently', style: 'destructive', onPress: async () => {
        try { await callFunction('deleteAccount', { confirmation: 'DELETE' }); }
        catch (error: any) { Alert.alert('Cannot delete account', error?.message ?? 'Please sign in again and retry.'); }
      } },
    ]);
  };

  const handleSignOut = () => {
    Alert.alert('Sign Out', 'Are you sure you want to sign out?', [
      { text: 'Cancel', style: 'cancel' },
      {
        text: 'Sign Out',
        style: 'destructive',
        onPress: async () => {
          await signOut(auth);
          router.replace('/(auth)/welcome');
        },
      },
    ]);
  };

  const MENU_ITEMS = [
    {
      group: 'Account',
      items: [
        {
          icon: History,
          label: 'Service History',
          sub: 'Past bookings and jobs',
          onPress: () => router.push('/history'),
        },
        ...(profile?.role === 'CUSTOMER'
          ? [
              {
                icon: Heart,
                label: 'Favorites',
                sub: 'Your saved cleaners',
                onPress: () => router.push('/favorites'),
              },
            ]
          : []),
        ...(profile?.role === 'CLEANER'
          ? [
              {
                icon: Star,
                label: 'My Reviews',
                sub: 'Ratings from customers',
                onPress: () => router.push('/reviews'),
              },
              {
                icon: Briefcase,
                label: 'My Portfolio',
                sub: 'Showcase your work',
                onPress: () => router.push('/portfolio'),
              },
            ]
          : []),
        {
          icon: Repeat,
          label: profile?.role === 'CLEANER' ? 'Switch to Customer' : 'Switch to Cleaner',
          sub:
            profile?.role === 'CLEANER'
              ? 'Go back to booking cleaners'
              : 'Start earning by accepting jobs',
          onPress: handleSwitchRole,
        },
      ],
    },
    {
      group: 'Legal',
      items: [
        {
          icon: FileText,
          label: 'Privacy Policy',
          sub: 'How we handle your data',
          onPress: () => router.push('/privacy-policy'),
        },
        ...(profile?.role === 'CUSTOMER'
          ? [
              {
                icon: FileText,
                label: 'Customer Agreement',
                sub: 'Platform terms for customers',
                onPress: () => router.push('/customer-agreement'),
              },
            ]
          : []),
        ...(profile?.role === 'CLEANER'
          ? [
              {
                icon: Shield,
                label: 'Cleaner Agreement',
                sub: 'Platform terms for cleaners',
                onPress: () => router.push('/cleaner-agreement'),
              },
            ]
          : []),
      ],
    },
    {
      group: 'Support',
      items: [
        {
          icon: HelpCircle,
          label: 'Help & Support',
          sub: 'FAQs and contact us',
          onPress: () => router.push('/help'),
        },
      ],
    },
  ];

  return (
    <SafeAreaView className="flex-1 bg-[#F2F1F5]">
      <ScrollView showsVerticalScrollIndicator={false}>
        {/* Header */}
        <View className="px-5 pt-4 pb-4">
          <Text className="text-2xl font-black text-slate-900 tracking-tight">Profile</Text>
        </View>

        {/* Profile card */}
        <View className="mx-5 mb-6 bg-white rounded-4xl p-6 border border-slate-100 shadow-sm">
          <View className="flex-row items-center gap-4">
            <TouchableOpacity
              onPress={handlePickProfilePhoto}
              disabled={isUploadingPhoto}
              activeOpacity={0.8}
              className="relative"
            >
              <View className="w-16 h-16 bg-accent rounded-3xl items-center justify-center overflow-hidden border border-slate-200">
                {isUploadingPhoto ? (
                  <ActivityIndicator color="#fff" size="small" />
                ) : profile?.photoURL ? (
                  <Image source={{ uri: profile.photoURL }} className="w-full h-full" />
                ) : (
                  <Text className="text-2xl font-black text-white">
                    {profile?.displayName?.charAt(0) ?? '?'}
                  </Text>
                )}
              </View>
              <View className="absolute -bottom-1 -right-1 w-6 h-6 rounded-full bg-accent items-center justify-center border-2 border-white shadow-xs">
                <Camera size={11} color="#fff" />
              </View>
            </TouchableOpacity>

            <View className="flex-1">
              <Text className="text-xl font-black text-slate-900">
                {profile?.displayName ?? 'User'}
              </Text>
              <Text className="text-sm text-slate-500 font-medium">{user?.email}</Text>
              <View className="flex-row items-center gap-2 mt-1">
                <View
                  className={`px-2.5 py-1 rounded-full ${
                    profile?.role === 'CLEANER' ? 'bg-accent/10' : 'bg-emerald-50'
                  }`}
                >
                  <Text
                    className={`text-[10px] font-black uppercase tracking-wider ${
                      profile?.role === 'CLEANER' ? 'text-accent' : 'text-emerald-700'
                    }`}
                  >
                    {profile?.role ?? 'CUSTOMER'}
                  </Text>
                </View>
              </View>
            </View>
            <TouchableOpacity
              onPress={handlePickProfilePhoto}
              className="w-10 h-10 bg-slate-50 rounded-2xl items-center justify-center border border-slate-100"
            >
              <Camera size={18} color="#64748b" />
            </TouchableOpacity>
          </View>

          {profile?.role === 'CLEANER' && (
            <View className="flex-row gap-3 mt-5 pt-5 border-t border-slate-100">
              {[
                { label: 'Jobs', value: profile.jobsCompleted ?? 0 },
                { label: 'Rating', value: profile.ratingAverage?.toFixed(1) ?? '—' },
                { label: 'Balance', value: `$${profile.balance?.toFixed(0) ?? 0}` },
              ].map(({ label, value }) => (
                <View key={label} className="flex-1 items-center">
                  <Text className="text-lg font-black text-slate-900">{String(value)}</Text>
                  <Text className="text-[10px] font-bold text-slate-400 uppercase tracking-wider mt-0.5">
                    {label}
                  </Text>
                </View>
              ))}
            </View>
          )}
        </View>

        {/* Settings toggle */}
        <View className="mx-5 mb-4 bg-white rounded-3xl px-5 py-4 flex-row items-center justify-between border border-slate-100">
          <View className="flex-row items-center gap-3">
            <View className="w-10 h-10 bg-accent/10 rounded-2xl items-center justify-center">
              <Bell size={18} color="#3906d2" />
            </View>
            <View>
              <Text className="text-sm font-black text-slate-900">Notifications</Text>
              <Text className="text-xs text-slate-400 font-medium">Job updates and alerts</Text>
            </View>
          </View>
          <Switch
            value={notificationsOn}
            onValueChange={setPushNotifications}
            trackColor={{ false: '#e2e8f0', true: '#3906d2' }}
            thumbColor="#fff"
          />
        </View>

        {/* Menu groups */}
        {MENU_ITEMS.map(({ group, items }) => (
          <View key={group} className="mx-5 mb-4">
            <Text className="text-xs font-black text-slate-400 uppercase tracking-widest mb-2 px-1">
              {group}
            </Text>
            <View className="bg-white rounded-3xl border border-slate-100 overflow-hidden">
              {items.map(({ icon: Icon, label, sub, onPress }, idx) => (
                <TouchableOpacity
                  key={label}
                  onPress={onPress}
                  className={`flex-row items-center gap-4 px-5 py-4 ${
                    idx < items.length - 1 ? 'border-b border-slate-50' : ''
                  }`}
                  activeOpacity={0.7}
                >
                  <View className="w-10 h-10 bg-slate-50 rounded-2xl items-center justify-center">
                    <Icon size={18} color="#64748b" />
                  </View>
                  <View className="flex-1">
                    <Text className="text-sm font-black text-slate-900">{label}</Text>
                    <Text className="text-xs text-slate-400 font-medium mt-0.5">{sub}</Text>
                  </View>
                  <ChevronRight size={16} color="#cbd5e1" />
                </TouchableOpacity>
              ))}
            </View>
          </View>
        ))}

        <TouchableOpacity onPress={handleDeleteAccount} className="mx-5 mb-3 py-4 rounded-3xl items-center border border-red-200" activeOpacity={0.8}>
          <Text className="text-red-600 font-black text-sm uppercase tracking-wider">Delete Account</Text>
        </TouchableOpacity>

        {/* Sign out */}
        <TouchableOpacity
          onPress={handleSignOut}
          className="mx-5 mb-10 bg-red-50 py-4 rounded-3xl flex-row items-center justify-center gap-3 border border-red-100"
          activeOpacity={0.8}
        >
          <LogOut size={18} color="#ef4444" />
          <Text className="text-red-500 font-black text-sm uppercase tracking-wider">Sign Out</Text>
        </TouchableOpacity>
      </ScrollView>
    </SafeAreaView>
  );
}
</file>

<file path="mobile/app/(tabs)/wallet.tsx">
import React, { useEffect, useState } from 'react';
import {
  View,
  Text,
  FlatList,
  TouchableOpacity,
  Modal,
  TextInput,
  ActivityIndicator,
  Alert,
} from 'react-native';
import { SafeAreaView } from 'react-native-safe-area-context';
import {
  ArrowUpRight,
  ArrowDownLeft,
  Plus,
  X,
  Smartphone,
  CreditCard,
  Wallet,
} from 'lucide-react-native';
import { useAuth } from '../../context/AuthContext';
import {
  db,
  collection,
  query,
  where,
  onSnapshot,
  orderBy,
  limit,
} from '../../services/supabase';
import { addFundsToWallet, getPaymentMethods } from '../../services/payments';
import { callFunction } from '../../services/functions';
import { WalletTransaction } from '../../types';

const METHOD_ICONS: Record<string, any> = {
  ecocash: Smartphone,
  card: CreditCard,
};

export default function WalletScreen() {
  const { user, profile } = useAuth();
  const [transactions, setTransactions] = useState<WalletTransaction[]>([]);
  const [isAddFundsOpen, setIsAddFundsOpen] = useState(false);
  const [amount, setAmount] = useState('');
  const [isLoading, setIsLoading] = useState(false);
  const [isPayoutOpen, setIsPayoutOpen] = useState(false);
  const [payoutAmount, setPayoutAmount] = useState('');
  const [payoutMethod, setPayoutMethod] = useState<'ECOCASH' | 'INNBUCKS' | 'BANK'>('ECOCASH');
  const [payoutName, setPayoutName] = useState('');
  const [payoutDestination, setPayoutDestination] = useState('');

  const paymentMethods = getPaymentMethods();

  // Real-time transaction feed from Firestore
  useEffect(() => {
    if (!user) return;
    const q = query(
      collection(db, 'transactions'),
      where('userId', '==', user.uid),
      orderBy('createdAt', 'desc'),
      limit(20)
    );
    return onSnapshot(q, (snap) => {
      setTransactions(snap.docs.map((d) => ({ id: d.id, ...d.data() } as WalletTransaction)));
    });
  }, [user]);

  const handleAddFunds = async () => {
    const value = parseFloat(amount);
    if (isNaN(value) || value < 1) {
      Alert.alert('Invalid amount', 'Minimum top-up is $1.00');
      return;
    }
    setIsLoading(true);
    try {
      const result = await addFundsToWallet(value);
      setIsAddFundsOpen(false);
      setAmount('');

      if (result.pending) {
        Alert.alert(
          'Payment Processing',
          'Your payment is being confirmed. Your balance will update automatically once the transaction is complete.'
        );
      }
    } catch (err: any) {
      if (err.message !== 'CANCELED') {
        Alert.alert('Payment Failed', err.message || 'Please try again.');
      }
    } finally {
      setIsLoading(false);
    }
  };

  const balance = profile?.balance ?? 0;
  const isCleaner = profile?.role === 'CLEANER';
  const availableEarnings = isCleaner ? Math.max(0, Number(profile?.balance ?? 0) - Number(profile?.commissionBalance ?? 0)) : 0;

  const requestPayout = async () => {
    setIsLoading(true);
    try {
      await callFunction('requestCleanerPayout', { amount: Number(payoutAmount), method: payoutMethod, accountName: payoutName, accountNumber: payoutDestination });
      setIsPayoutOpen(false); setPayoutAmount(''); setPayoutName(''); setPayoutDestination('');
      Alert.alert('Payout requested', 'Your cleared earnings are reserved. Detail will send the transfer and update the request status.');
    } catch (error: any) {
      Alert.alert('Could not request payout', error?.message ?? 'Please check the amount and payout details.');
    } finally { setIsLoading(false); }
  };

  return (
    <SafeAreaView className="flex-1 bg-[#F2F1F5]">
      {/* Header */}
      <View className="px-5 pt-4 pb-4">
        <Text className="text-2xl font-display font-black text-slate-900 tracking-tight">Wallet</Text>
      </View>

      {/* Balance card */}
      <View className="mx-5 mb-6 bg-accent rounded-4xl p-6 shadow-xl shadow-accent/30">
        <View className="flex-row items-center gap-2 mb-4">
          <Wallet size={18} color="rgba(255,255,255,0.7)" />
          <Text className="text-xs font-display font-black text-white/70 uppercase tracking-widest">
            {isCleaner ? 'Available earnings' : 'Available Balance'}
          </Text>
        </View>
        <Text className="text-4xl font-display font-black text-white mb-1">${(isCleaner ? availableEarnings : balance).toFixed(2)}</Text>
        <Text className="font-sans text-sm text-white/60 font-medium">{isCleaner ? `Cleared earnings · $${Number(profile?.commissionBalance ?? 0).toFixed(2)} commission credit` : 'Detail Wallet'}</Text>

        <View className="flex-row gap-3 mt-6">
          <TouchableOpacity
            onPress={() => setIsAddFundsOpen(true)}
            className="flex-1 bg-white/20 py-3 rounded-2xl flex-row items-center justify-center gap-2"
            activeOpacity={0.8}
          >
            <Plus size={16} color="#fff" />
            <Text className="text-white font-display font-black text-xs uppercase tracking-wider">{isCleaner ? 'Top up commission' : 'Add Funds'}</Text>
          </TouchableOpacity>
          <TouchableOpacity
            onPress={() => isCleaner ? setIsPayoutOpen(true) : Alert.alert('Withdraw', 'Withdrawals are available for cleaner earnings.')}
            className="flex-1 bg-white/20 py-3 rounded-2xl flex-row items-center justify-center gap-2"
            activeOpacity={0.8}
          >
            <ArrowUpRight size={16} color="#fff" />
            <Text className="text-white font-display font-black text-xs uppercase tracking-wider">{isCleaner ? 'Request payout' : 'Withdraw'}</Text>
          </TouchableOpacity>
        </View>
      </View>

      {balance < 0 && (
        <TouchableOpacity
          onPress={() => setIsAddFundsOpen(true)}
          activeOpacity={0.85}
          className="mx-5 mb-6 bg-red-50 border border-red-100 rounded-3xl p-4 flex-row items-center gap-3"
        >
          <View className="w-10 h-10 bg-red-100 rounded-2xl items-center justify-center">
            <ArrowUpRight size={18} color="#ef4444" />
          </View>
          <View className="flex-1">
            <Text className="text-sm font-display font-black text-red-700">Outstanding commission balance</Text>
            <Text className="font-sans text-xs text-red-500 font-medium mt-0.5">
              Add funds to bring your balance to $0 and keep bidding on jobs
            </Text>
          </View>
        </TouchableOpacity>
      )}

      {/* Payment methods (informational — the processor handles selection on its hosted page) */}
      <View className="mx-5 mb-6">
        <Text className="text-xs font-display font-black text-slate-400 uppercase tracking-widest mb-3">
          Accepted Payment Methods
        </Text>
        <View className="bg-white rounded-3xl border border-slate-100 overflow-hidden">
          {paymentMethods.map(({ id, label, sub }, idx) => {
            const Icon = METHOD_ICONS[id] ?? CreditCard;
            return (
              <View
                key={id}
                className={`flex-row items-center gap-4 px-5 py-4 ${
                  idx < paymentMethods.length - 1 ? 'border-b border-slate-50' : ''
                }`}
              >
                <View className="w-10 h-10 bg-accent/10 rounded-2xl items-center justify-center">
                  <Icon size={18} color="#3906d2" />
                </View>
                <View className="flex-1">
                  <Text className="text-sm font-display font-black text-slate-900">{label}</Text>
                  <Text className="font-sans text-xs text-slate-400 font-medium mt-0.5">{sub}</Text>
                </View>
              </View>
            );
          })}
        </View>
      </View>

      {/* Transactions */}
      <View className="flex-1 px-5">
        <Text className="text-xs font-display font-black text-slate-400 uppercase tracking-widest mb-3">
          Recent Transactions
        </Text>
        {transactions.length === 0 ? (
          <View className="bg-white rounded-3xl p-8 items-center border border-slate-100">
            <Text className="font-sans text-3xl mb-3">💳</Text>
            <Text className="text-sm font-display font-black text-slate-600 text-center">
              No transactions yet
            </Text>
          </View>
        ) : (
          <FlatList
            data={transactions}
            keyExtractor={(t) => t.id}
            showsVerticalScrollIndicator={false}
            contentContainerClassName="gap-3"
            renderItem={({ item }) => (
              <View className="bg-white rounded-3xl p-4 flex-row items-center gap-4 border border-slate-100">
                <View
                  className={`w-12 h-12 rounded-2xl items-center justify-center ${
                    item.type === 'CREDIT' ? 'bg-emerald-50' : 'bg-red-50'
                  }`}
                >
                  {item.type === 'CREDIT' ? (
                    <ArrowDownLeft size={22} color="#10b981" />
                  ) : (
                    <ArrowUpRight size={22} color="#ef4444" />
                  )}
                </View>
                <View className="flex-1">
                  <Text className="text-sm font-display font-black text-slate-900">{item.description}</Text>
                  <Text className="font-sans text-xs text-slate-400 font-medium mt-0.5">
                    {item.createdAt?.toDate?.()?.toLocaleDateString() ?? 'Recent'}
                  </Text>
                </View>
                <View className="items-end">
                  <Text
                    className={`text-base font-black ${
                      item.type === 'CREDIT' ? 'text-emerald-600' : 'text-red-500'
                    }`}
                  >
                    {item.type === 'CREDIT' ? '+' : '-'}${item.amount.toFixed(2)}
                  </Text>
                  {(item as any).status === 'PENDING' && (
                    <Text className="text-[10px] font-display font-black text-amber-500 uppercase tracking-wider mt-0.5">
                      Pending
                    </Text>
                  )}
                </View>
              </View>
            )}
          />
        )}
      </View>

      {/* Add Funds Modal */}
      <Modal visible={isAddFundsOpen} transparent animationType="slide">
        <View className="flex-1 justify-end">
          <TouchableOpacity
            className="flex-1 bg-black/50"
            onPress={() => setIsAddFundsOpen(false)}
          />
          <View className="bg-white rounded-t-[32px] p-6 pb-10">
            <View className="flex-row items-center justify-between mb-1">
              <Text className="text-xl font-display font-black text-slate-900">{isCleaner ? 'Top up commission credit' : 'Add Funds'}</Text>
              <TouchableOpacity onPress={() => setIsAddFundsOpen(false)}>
                <X size={22} color="#94a3b8" />
              </TouchableOpacity>
            </View>
            <Text className="font-sans text-xs text-slate-400 font-medium mb-6">
              {isCleaner ? 'Prepaid credit for direct-payment booking commissions' : 'Add USD credit to your Detail wallet'}
            </Text>

            <View className="mb-5 flex-row items-center gap-3 rounded-2xl border border-violet-100 bg-[#F7F4FF] p-3.5"><View className="h-10 w-10 items-center justify-center rounded-xl bg-accent"><Text className="font-display text-lg font-black text-white">P</Text></View><View className="flex-1"><Text className="font-display text-sm font-black text-ink">Paynow secure checkout</Text><Text className="font-sans text-[11px] text-ink/55">Choose EcoCash, mobile money, or card on Paynow</Text></View></View>

            <Text className="text-xs font-display font-black text-slate-500 uppercase tracking-widest mb-2">
              Amount (USD)
            </Text>
            <TextInput
              className="border-2 border-slate-100 rounded-2xl px-4 py-4 text-2xl font-display font-black text-slate-900 bg-slate-50 mb-4"
              placeholder="0.00"
              placeholderTextColor="#94a3b8"
              keyboardType="decimal-pad"
              value={amount}
              onChangeText={setAmount}
              autoFocus
            />

            {/* Quick-amount chips */}
            <View className="flex-row gap-2 mb-5">
              {['5', '10', '25', '50'].map((preset) => (
                <TouchableOpacity
                  key={preset}
                  onPress={() => setAmount(preset)}
                  className={`flex-1 py-2.5 rounded-2xl items-center border ${
                    amount === preset ? 'bg-accent border-accent' : 'bg-slate-50 border-slate-100'
                  }`}
                >
                  <Text
                    className={`text-xs font-black ${
                      amount === preset ? 'text-white' : 'text-slate-600'
                    }`}
                  >
                    ${preset}
                  </Text>
                </TouchableOpacity>
              ))}
            </View>

            <TouchableOpacity
              onPress={handleAddFunds}
              disabled={isLoading || !amount}
              className="bg-accent py-5 rounded-[32px] items-center shadow-lg shadow-accent/30"
              activeOpacity={0.85}
            >
              {isLoading ? (
                <ActivityIndicator color="#fff" />
              ) : (
                <Text className="text-white font-display font-black text-sm uppercase tracking-widest">
                  {`Continue securely · $${amount || '0.00'}`}
                </Text>
              )}
            </TouchableOpacity>
          </View>
        </View>
      </Modal>
      <Modal visible={isPayoutOpen} transparent animationType="slide">
        <View className="flex-1 justify-end bg-black/50"><View className="bg-white rounded-t-[32px] p-6 pb-10">
          <View className="flex-row justify-between items-center mb-4"><Text className="text-xl font-display font-black">Request payout</Text><TouchableOpacity onPress={() => setIsPayoutOpen(false)}><X size={22} color="#94a3b8" /></TouchableOpacity></View>
          <Text className="font-sans text-sm text-slate-500 mb-3">Available cleared earnings: ${availableEarnings.toFixed(2)}. Minimum payout $5. Transfers are sent manually while payout integrations are unavailable.</Text>
          <TextInput className="font-sans border border-slate-200 rounded-xl p-4 mb-3" placeholder="Amount in USD" keyboardType="decimal-pad" value={payoutAmount} onChangeText={setPayoutAmount} />
          <View className="flex-row gap-2 mb-3">{(['ECOCASH','INNBUCKS','BANK'] as const).map(m => <TouchableOpacity key={m} onPress={() => setPayoutMethod(m)} className={`flex-1 p-3 rounded-xl ${payoutMethod === m ? 'bg-accent' : 'bg-slate-100'}`}><Text className={`text-center text-xs font-bold ${payoutMethod === m ? 'text-white' : 'text-slate-700'}`}>{m}</Text></TouchableOpacity>)}</View>
          <TextInput className="font-sans border border-slate-200 rounded-xl p-4 mb-3" placeholder="Account / wallet holder name" value={payoutName} onChangeText={setPayoutName} />
          <TextInput className="font-sans border border-slate-200 rounded-xl p-4 mb-4" placeholder={payoutMethod === 'BANK' ? 'Bank account number and bank' : 'Mobile money number'} value={payoutDestination} onChangeText={setPayoutDestination} />
          <TouchableOpacity disabled={isLoading} onPress={requestPayout} className="bg-accent rounded-2xl p-4 items-center">{isLoading ? <ActivityIndicator color="#fff" /> : <Text className="text-white font-display font-black">Submit payout request</Text>}</TouchableOpacity>
        </View></View>
      </Modal>
    </SafeAreaView>
  );
}
</file>

<file path="mobile/app/job/[jobId].tsx">
import React, { useEffect, useState } from 'react';
import {
  View,
  Text,
  TouchableOpacity,
  ScrollView,
  TextInput,
  ActivityIndicator,
  Alert,
  KeyboardAvoidingView,
  Platform,
  Image,
  Modal,
} from 'react-native';
import { SafeAreaView } from 'react-native-safe-area-context';
import { router, useLocalSearchParams } from 'expo-router';
import { ArrowLeft, MapPin, Clock, DollarSign, MessageSquare, Hash, Home, Layers, Sparkles, X } from 'lucide-react-native';
import { useAuth } from '../../context/AuthContext';
import { db, doc, collection, onSnapshot, query, where, getDocs, limit } from '../../services/supabase';
import { callFunction } from '../../services/functions';
import { Job, JobStatus, HouseChecklist, CarChecklist } from '../../types';
import { IS_MOCK } from '../../utils/env';
import { haversineDistanceKm } from '../../services/matching';
import * as Location from 'expo-location';

export default function CleanerJobDetailScreen() {
  const { jobId } = useLocalSearchParams<{ jobId: string }>();
  const { user, profile } = useAuth();
  const [job, setJob] = useState<Job | null>(null);
  const [isLoading, setIsLoading] = useState(true);
  const [alreadyBid, setAlreadyBid] = useState(false);
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [selectedPhotoUrl, setSelectedPhotoUrl] = useState<string | null>(null);

  const [bidPrice, setBidPrice] = useState('');
  const [estimatedArrival, setEstimatedArrival] = useState('');
  const [message, setMessage] = useState('');

  const [currentLocation, setCurrentLocation] = useState<{ lat: number; lng: number } | null>(null);

  useEffect(() => {
    Location.getCurrentPositionAsync({ accuracy: Location.Accuracy.Balanced })
      .then(({ coords }) => setCurrentLocation({ lat: coords.latitude, lng: coords.longitude }))
      .catch(() => {});
  }, []);

  useEffect(() => {
    if (!jobId) return;
    return onSnapshot(
      doc(db, 'jobs', jobId),
      (snap) => {
        if (snap.exists()) setJob({ id: snap.id, ...snap.data() } as Job);
        setIsLoading(false);
      },
      () => setIsLoading(false)
    );
  }, [jobId]);

  useEffect(() => {
    if (!jobId || !user) return;
    const q = query(collection(db, 'bids'), where('jobId', '==', jobId), where('cleanerId', '==', user.uid), limit(1));
    getDocs(q).then((snap) => setAlreadyBid(!snap.empty));
  }, [jobId, user]);

  const handleSubmitBid = async () => {
    const price = parseFloat(bidPrice);
    const eta = parseInt(estimatedArrival, 10);

    if (isNaN(price) || price < 1) {
      Alert.alert('Invalid Price', 'Please enter a valid bid price.');
      return;
    }
    if (isNaN(eta) || eta < 1 || eta > 120) {
      Alert.alert('Invalid ETA', 'Please enter an estimated arrival time in minutes (1–120).');
      return;
    }
    if (!user || !profile) return;
    if (job?.status !== JobStatus.PENDING) {
      Alert.alert('Too Late', 'This job is no longer accepting bids.');
      return;
    }

    setIsSubmitting(true);
    try {
      await callFunction('submitBid', {
        jobId,
        bidPrice: price,
        estimatedArrival: eta,
        message: message.trim() || undefined,
      });
      setAlreadyBid(true);
      Alert.alert('Bid Placed!', "Your offer has been sent to the customer. You'll be notified if they accept.");
    } catch (err: any) {
      Alert.alert('Error', err.message || 'Failed to submit bid. Please try again.');
    } finally {
      setIsSubmitting(false);
    }
  };

  if (isLoading) {
    return (
      <View className="flex-1 items-center justify-center bg-white">
        <ActivityIndicator color="#3906D2" size="large" />
      </View>
    );
  }

  if (!job) {
    return (
      <SafeAreaView className="flex-1 bg-white items-center justify-center px-6">
        <Text className="text-lg font-black text-ink text-center">Job not found</Text>
        <TouchableOpacity onPress={() => router.back()} className="mt-4">
          <Text className="text-accent font-black">Go Back</Text>
        </TouchableOpacity>
      </SafeAreaView>
    );
  }

  const isTaken = job.status !== JobStatus.PENDING;
  const distance = IS_MOCK
    ? '2.3 km away'
    : currentLocation && job.location?.lat && job.location?.lng
    ? `${haversineDistanceKm(currentLocation, { lat: job.location.lat, lng: job.location.lng }).toFixed(1)} km away`
    : null;

  const budgetLabel = job.budget ? `$${job.budget}` : 'Open — send your best price';

  const checklistTags = getChecklistTags(job);

  return (
    <SafeAreaView className="flex-1 bg-[#F3F1FC]">
      <KeyboardAvoidingView className="flex-1" behavior={Platform.OS === 'ios' ? 'padding' : 'height'}>
        <View className="flex-row items-center gap-3 px-5 pt-4 pb-4">
          <TouchableOpacity onPress={() => router.back()} className="w-10 h-10 bg-white rounded-2xl items-center justify-center border border-ink/5">
            <ArrowLeft size={18} color="#150256" />
          </TouchableOpacity>
          <View className="flex-1">
            <Text className="text-xl font-black text-ink">{job.serviceType}</Text>
            <Text className="text-xs text-ink/40 font-medium">#{jobId?.slice(-6).toUpperCase()}</Text>
          </View>
          {isTaken && (
            <View className="bg-amber-100 px-3 py-1.5 rounded-xl">
              <Text className="text-xs font-black text-amber-700 uppercase tracking-wider">{job.status}</Text>
            </View>
          )}
        </View>

        <ScrollView showsVerticalScrollIndicator={false} contentContainerStyle={{ paddingBottom: 40 }}>
          <View className="mx-5 bg-white rounded-3xl p-5 border border-ink/5 mb-4">
            <Text className="text-xs font-black text-ink/40 uppercase tracking-widest mb-3">
              {job.category === 'CAR' ? '🚗 Car Cleaning' : '🏠 House Cleaning'}
            </Text>

            <View className="gap-3">
              <DetailRow icon={MapPin} title="Location" value={job.location?.address ?? 'Address not provided'} accent={distance ?? undefined} />
              <DetailRow icon={DollarSign} title="Customer Budget" value={budgetLabel} />
              <DetailRow icon={Clock} title="Estimated Duration" value={job.estimatedDuration ? `${job.estimatedDuration} hours` : '2–3 hours'} />
              {job.category === 'HOUSE' && (
                <>
                  {Boolean((job.checklist as HouseChecklist)?.storiesCount || (job.checklist as HouseChecklist)?.roomsCount) && (
                    <DetailRow
                      icon={Home}
                      title="Property Layout"
                      value={[
                        (job.checklist as HouseChecklist).storiesCount ? `${(job.checklist as HouseChecklist).storiesCount} Story` : null,
                        (job.checklist as HouseChecklist).roomsCount ? `${(job.checklist as HouseChecklist).roomsCount} Rooms to clean` : null,
                        (job.checklist as HouseChecklist).bathroomsCount ? `${(job.checklist as HouseChecklist).bathroomsCount} Baths` : null,
                        (job.checklist as HouseChecklist).propertySizeSqm ? `${(job.checklist as HouseChecklist).propertySizeSqm} m²` : null,
                      ].filter(Boolean).join(' · ')}
                      highlight
                    />
                  )}
                </>
              )}
              {job.category === 'CAR' && (job.checklist as CarChecklist)?.registrationNumber && (
                <DetailRow
                  icon={Hash}
                  title="Vehicle Registration"
                  value={(job.checklist as CarChecklist).registrationNumber!}
                  highlight
                />
              )}
              {job.description && <DetailRow icon={MessageSquare} title="Notes" value={job.description} />}
            </View>

            {checklistTags.length > 0 && (
              <View className="flex-row flex-wrap gap-2 mt-4 pt-4 border-t border-ink/5">
                {checklistTags.map((tag) => (
                  <View key={tag} className="bg-accent/10 px-3 py-1.5 rounded-full">
                    <Text className="text-[11px] font-black text-accent">{tag}</Text>
                  </View>
                ))}
              </View>
            )}

            {job.photos?.length > 0 && (
              <View className="mt-4 pt-4 border-t border-ink/5">
                <View className="flex-row items-center justify-between mb-2">
                  <Text className="text-xs font-black text-ink/60 uppercase tracking-wider">
                    📸 Photos of What Needs Cleaning ({job.photos.length})
                  </Text>
                  <Text className="text-[10px] font-bold text-accent">Tap to enlarge</Text>
                </View>
                <ScrollView horizontal showsHorizontalScrollIndicator={false} contentContainerStyle={{ gap: 8 }}>
                  {job.photos.map((url) => (
                    <TouchableOpacity
                      key={url}
                      onPress={() => setSelectedPhotoUrl(url)}
                      activeOpacity={0.8}
                      className="relative rounded-2xl overflow-hidden border border-ink/10"
                    >
                      <Image source={{ uri: url }} style={{ width: 88, height: 88 }} />
                      <View className="absolute bottom-1 left-1 bg-black/75 px-1.5 py-0.5 rounded-md">
                        <Text className="text-[8px] font-black text-white uppercase">Dirty / Before</Text>
                      </View>
                    </TouchableOpacity>
                  ))}
                </ScrollView>
              </View>
            )}

            {job.completionPhotos && job.completionPhotos.length > 0 && (
              <View className="mt-4 pt-4 border-t border-ink/5">
                <View className="flex-row items-center justify-between mb-2">
                  <Text className="text-xs font-black text-emerald-700 uppercase tracking-wider">
                    ✨ Photos When Done ({job.completionPhotos.length})
                  </Text>
                  <Text className="text-[10px] font-bold text-emerald-700">Completed</Text>
                </View>
                <ScrollView horizontal showsHorizontalScrollIndicator={false} contentContainerStyle={{ gap: 8 }}>
                  {job.completionPhotos.map((url) => (
                    <TouchableOpacity
                      key={url}
                      onPress={() => setSelectedPhotoUrl(url)}
                      activeOpacity={0.8}
                      className="relative rounded-2xl overflow-hidden border border-emerald-200"
                    >
                      <Image source={{ uri: url }} style={{ width: 88, height: 88 }} />
                      <View className="absolute bottom-1 left-1 bg-emerald-700/85 px-1.5 py-0.5 rounded-md">
                        <Text className="text-[8px] font-black text-white uppercase">Completed</Text>
                      </View>
                    </TouchableOpacity>
                  ))}
                </ScrollView>
              </View>
            )}
          </View>

          {isTaken ? (
            <View className="mx-5 bg-amber-50 rounded-3xl p-5 border border-amber-100">
              <Text className="text-sm font-black text-amber-700 text-center">This job has already been accepted</Text>
            </View>
          ) : alreadyBid ? (
            <View className="mx-5 bg-emerald-50 rounded-3xl p-5 border border-emerald-100 items-center">
              <Text className="text-2xl mb-2">✅</Text>
              <Text className="text-sm font-black text-emerald-700 text-center">Bid submitted — waiting for customer to accept</Text>
            </View>
          ) : (
            <View className="mx-5 bg-white rounded-3xl p-5 border border-ink/5">
              <Text className="text-xs font-black text-ink/40 uppercase tracking-widest mb-4">Place Your Bid</Text>

              <Text className="text-xs font-black text-ink/50 uppercase tracking-widest mb-1.5">Your Price (USD)</Text>
              <TextInput
                className="border-2 border-ink/10 rounded-2xl px-4 py-3.5 text-xl font-black text-ink bg-ink/[0.02] mb-4"
                placeholder={`${job.budget ?? '0'}.00`}
                placeholderTextColor="#9C94C4"
                keyboardType="decimal-pad"
                value={bidPrice}
                onChangeText={setBidPrice}
              />

              <Text className="text-xs font-black text-ink/50 uppercase tracking-widest mb-1.5">Estimated Arrival (minutes)</Text>
              <TextInput
                className="border-2 border-ink/10 rounded-2xl px-4 py-3.5 text-base font-bold text-ink bg-ink/[0.02] mb-4"
                placeholder="e.g. 20"
                placeholderTextColor="#9C94C4"
                keyboardType="number-pad"
                value={estimatedArrival}
                onChangeText={setEstimatedArrival}
              />

              <View className="flex-row gap-2 mb-4">
                {['10', '20', '30', '45'].map((t) => (
                  <TouchableOpacity
                    key={t}
                    onPress={() => setEstimatedArrival(t)}
                    className={`flex-1 py-2 rounded-xl items-center border ${estimatedArrival === t ? 'bg-accent border-accent' : 'bg-ink/[0.02] border-ink/10'}`}
                  >
                    <Text className={`text-xs font-black ${estimatedArrival === t ? 'text-white' : 'text-ink/60'}`}>{t} min</Text>
                  </TouchableOpacity>
                ))}
              </View>

              <Text className="text-xs font-black text-ink/50 uppercase tracking-widest mb-1.5">Message (optional)</Text>
              <TextInput
                className="border-2 border-ink/10 rounded-2xl px-4 py-3 text-sm font-medium text-ink bg-ink/[0.02] mb-5"
                placeholder="Introduce yourself or mention your experience…"
                placeholderTextColor="#9C94C4"
                multiline
                numberOfLines={3}
                maxLength={200}
                value={message}
                onChangeText={setMessage}
              />

              <TouchableOpacity
                onPress={handleSubmitBid}
                disabled={isSubmitting || !bidPrice || !estimatedArrival}
                activeOpacity={0.85}
                className={`py-5 rounded-[32px] items-center ${bidPrice && estimatedArrival ? 'bg-accent shadow-lg shadow-accent/30' : 'bg-ink/10'}`}
              >
                {isSubmitting ? (
                  <ActivityIndicator color="#fff" />
                ) : (
                  <Text className={`font-black text-sm uppercase tracking-widest ${bidPrice && estimatedArrival ? 'text-white' : 'text-ink/30'}`}>
                    Submit Bid ${bidPrice || '—'}
                  </Text>
                )}
              </TouchableOpacity>
            </View>
          )}
        </ScrollView>
      </KeyboardAvoidingView>

      <Modal
        visible={!!selectedPhotoUrl}
        transparent
        animationType="fade"
        onRequestClose={() => setSelectedPhotoUrl(null)}
      >
        <View className="flex-1 bg-black/90 items-center justify-center p-4">
          <TouchableOpacity
            onPress={() => setSelectedPhotoUrl(null)}
            className="absolute top-12 right-6 w-10 h-10 rounded-full bg-white/20 items-center justify-center z-10"
          >
            <X size={22} color="#fff" />
          </TouchableOpacity>
          {selectedPhotoUrl && (
            <Image
              source={{ uri: selectedPhotoUrl }}
              style={{ width: '100%', height: '80%', resizeMode: 'contain' }}
            />
          )}
        </View>
      </Modal>
    </SafeAreaView>
  );
}

function DetailRow({
  icon: Icon, title, value, accent, highlight,
}: {
  icon: any; title: string; value: string; accent?: string; highlight?: boolean;
}) {
  return (
    <View className={`flex-row items-start gap-3 ${highlight ? 'bg-accent/5 -mx-1 px-1 py-1.5 rounded-2xl' : ''}`}>
      <View className={`w-8 h-8 rounded-xl items-center justify-center mt-0.5 ${highlight ? 'bg-accent' : 'bg-accent/10'}`}>
        <Icon size={14} color={highlight ? '#fff' : '#3906D2'} />
      </View>
      <View className="flex-1">
        <Text className="text-sm font-black text-ink">{title}</Text>
        <Text className={`text-sm font-black mt-0.5 tracking-widest ${highlight ? 'text-accent' : 'text-xs text-ink/50 font-medium'}`}>
          {value}
        </Text>
        {accent && <Text className="text-xs text-accent font-black mt-0.5">{accent}</Text>}
      </View>
    </View>
  );
}

function getChecklistTags(job: Job): string[] {
  const checklist = job.checklist;
  if (!checklist) return [];
  if (checklist.category === 'HOUSE') {
    const c = checklist as HouseChecklist;
    return [...(c.cleaningTypes ?? []), ...(c.areas ?? []).slice(0, 4)];
  }
  const c = checklist as CarChecklist;
  return [...(c.cleaningTypes ?? []), ...(c.exteriorServices ?? []).slice(0, 2), ...(c.interiorServices ?? []).slice(0, 2)];
}
