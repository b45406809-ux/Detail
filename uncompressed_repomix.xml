        style={[
          StyleSheet.absoluteFill,
          { backgroundColor: variant === 'light' ? 'rgba(255,255,255,0.5)' : 'rgba(13,10,36,0.5)' },
        ]}
      />
      {children}
    </TouchableOpacity>
  );
}

const styles = StyleSheet.create({
  wrap: {
    alignItems: 'center',
    justifyContent: 'center',
    borderWidth: 1,
    overflow: 'hidden',
    shadowColor: '#3906D2',
    shadowOpacity: 0.15,
    shadowRadius: 12,
    shadowOffset: { width: 0, height: 4 },
    elevation: 4,
  },
});
