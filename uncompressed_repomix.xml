  suppliesFee?: number;
  arrivalAt?: any;
  serviceStartedAt?: any;
  completionSubmittedAt?: any;
  customerResponseAt?: any;
  matchExpiresAt?: any;
  createdAt?: any;
  /** When the job stops accepting new bids — 30 min from creation, extended
