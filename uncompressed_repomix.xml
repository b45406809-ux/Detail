  const submit=async(e:React.FormEvent<HTMLFormElement>)=>{e.preventDefault(); setStatus('sending'); setError(''); track('waitlist_start',{}); const form=new FormData(e.currentTarget);
    try { await joinWaitlist({ participantType:form.get('participantType'), fullName:form.get('fullName'), phone:form.get('phone'), email:form.get('email'), country:form.get('country'), city:form.get('city'), area:form.get('area'), preferredLanguage:form.get('preferredLanguage'), serviceInterest:form.get('serviceInterest'), marketingEmailPermission:form.get('marketingEmailPermission'), privacyAccepted:form.get('privacyAccepted')==='on', website:form.get('website'), turnstileToken:form.get('cf-turnstile-response'), campaign:{source:new URLSearchParams(location.search).get('utm_source'),medium:new URLSearchParams(location.search).get('utm_medium'),campaign:new URLSearchParams(location.search).get('utm_campaign')}}); setStatus('success'); track('waitlist_submitted',{participantType}); }
