<file path="firestore.rules">
rules_version = '2';
// ═══════════════════════════════════════════════════════════════════════
// TEMPORARY — SIMULATE MODE (search this repo for EXPO_PUBLIC_SIMULATE_FUNCTIONS)
//
// Cloud Functions can't be deployed yet (Firebase Blaze billing not
// enabled), so the mobile app's services/functionSimulators.ts replicates
// several Functions' writes directly from the client for testing purposes.
// Every relaxation below is marked "SIMULATE MODE" and exists ONLY to let
// those simulators write what the real Cloud Function would have written.
//
// MUST REVERT before real users or real money touch this app: once Blaze
// is enabled and the real Functions in functions/src/index.ts are deployed,
// undo every "SIMULATE MODE" block below (git history has the strict
// version — see the commit that introduced this banner) and flip
// EXPO_PUBLIC_SIMULATE_FUNCTIONS to false.
// ═══════════════════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuth() && request.auth.token.admin == true;
    }

    function hasPermission(permission) {
      return isAdmin() && permission in request.auth.token.permissions;
    }

    // Keys that change when an update touches any of the listed fields.
    function changed(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ───────────────────────── users ─────────────────────────
    // Anyone signed in can READ a profile (cleaner name/rating on bid cards).
    // A user may only write their OWN document, and may NEVER set or change the
    // money / trust fields — those are owned exclusively by Cloud Functions
    // (settlement, rating aggregation, admin moderation) via the Admin SDK.
    match /users/{userId} {
      allow read: if isAdmin() || (isAuth() && (resource.id == request.auth.uid || resource.data.role == 'CLEANER'));

      allow create: if isOwner(userId)
        && request.resource.data.balance == 0
        && (!('jobsCompleted' in request.resource.data) || request.resource.data.jobsCompleted == 0)
        && (!('ratingAverage' in request.resource.data) || request.resource.data.ratingAverage == 0)
        && (!('ratingCount' in request.resource.data) || request.resource.data.ratingCount == 0)
        && (!('isSuspended' in request.resource.data) || request.resource.data.isSuspended == false)
        && (!('isBanned' in request.resource.data) || request.resource.data.isBanned == false);

      allow update: if (
        isOwner(userId)
        && !changed([
          'commissionOwed', 'isSuspended', 'isBanned', 'verificationLevel',
          'uid', 'email'
        ])
      );

      allow delete: if false;
    }

    // ───────────────────────── transactions ─────────────────────────
    // Immutable ledger. Read your own only. Normally ALL writes happen
    // server-side (settlement, PesePay webhook). SIMULATE MODE: temporarily
    // allowed to create a ledger entry for ANY userId (not just your own) —
    // simulateSettleJobPayment writes the other party's (e.g. the customer
    // writes the cleaner's earnings entry) ledger entry too, same
    // cross-user shape as the users.balance relaxation above. Lower risk
    // than that one: this is just a record, not the actual balance change.
    // Still never editable/deletable.
    match /transactions/{txId} {
      allow read: if isAdmin() || (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if false;
      allow update, delete: if false;
    }

    // ───────────────────────── jobs / bids ─────────────────────────
    // All booking state, assignment, bid, and payment writes are callable-only.
    match /jobs/{jobId} {
      allow read: if isAdmin() || (isAuth() && (resource.data.customerId == request.auth.uid || resource.data.cleanerId == request.auth.uid || resource.data.status == 'PENDING'));
      allow create, update, delete: if false;
      match /events/{eventId} {
        allow read: if isAdmin() || (isAuth() && (get(/databases/$(database)/documents/jobs/$(jobId)).data.customerId == request.auth.uid || get(/databases/$(database)/documents/jobs/$(jobId)).data.cleanerId == request.auth.uid));
        allow write: if false;
      }
    }
    match /bids/{bidId} {
      allow read: if isAdmin() || isAuth();
      allow write: if false;
    }

    // ───────────────────────── messages ─────────────────────────
    // Chat unlocks the instant a bid is accepted, not before: the sender must
    // be a participant on the job AND the job must have left BIDDING (i.e.
    // acceptBid has run and set cleanerId) — a real server-side guarantee,
    // not just a client-side convention.
    match /messages/{msgId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.senderId == request.auth.uid
        && get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.status != 'BIDDING'
        && (
          get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.customerId == request.auth.uid ||
          get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.cleanerId == request.auth.uid
        );
      allow update, delete: if false;
    }

    // ───────────────────────── reviews ─────────────────────────
    // Normally written only by the submitRating function. SIMULATE MODE:
    // temporarily allowed directly by the client (customerId == caller) so
    // simulateSubmitRating can write it.
    match /reviews/{reviewId} {
      allow read: if isAdmin() || isAuth();
      allow create: if false;
      allow update, delete: if false;
    }

    // ───────────────────────── agreement logs ─────────────────────────
    match /agreement_logs/{logId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ───────────────────────── disputes ─────────────────────────
    // Normally filed via the reportJobIssue Cloud Function only (needs
    // server-side validation that the job is COMPLETED and theirs).
    // SIMULATE MODE: temporarily allowed directly by the client (customerId
    // == caller) so simulateReportJobIssue can write it. Resolution/refunds
    // stay function-only always (resolveDispute, staff-invoked) — not part
    // of the simulate layer.
    match /disputes/{disputeId} {
      allow read: if isAdmin() || (isAuth() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.cleanerId == request.auth.uid
      ));
      allow create: if false;
      allow update, delete: if false;
    }

    // ───────────────────────── invoices ─────────────────────────
    match /invoices/{invoiceId} {
      allow read: if isAuth() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.cleanerId == request.auth.uid
      );
      allow write: if false; // Cloud Functions only
    }

    // ───────────────────────── favorites ─────────────────────────
    // A customer's saved cleaners, for quick rebooking. No money/trust fields
    // involved, so plain client writes are safe — scoped to the caller's own docs.
    match /favorites/{favoriteId} {
      allow read: if isAuth() && resource.data.customerId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.customerId == request.auth.uid;
      allow delete: if isAuth() && resource.data.customerId == request.auth.uid;
      allow update: if false;
    }

    // ───────────────────────── notifications ─────────────────────────
    // Written exclusively by Cloud Functions triggers (new bid, job status
    // change, new message). Clients may only flip their own `read` flag.
    match /notifications/{notificationId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow update: if isAuth()
        && resource.data.userId == request.auth.uid
        && !changed(['userId', 'type', 'title', 'body', 'jobId', 'createdAt']);
      allow create, delete: if false;
    }

    match /configuration/{document} { allow read: if isAdmin(); allow write: if false; }
    match /reviewCases/{caseId} { allow read: if isAdmin(); allow write: if false; }
    match /supportCases/{caseId} { allow read: if isAdmin(); allow write: if false; }
    match /payments/{paymentId} { allow read: if isAdmin() || (isAuth() && resource.data.customerId == request.auth.uid); allow write: if false; }
    match /refunds/{refundId} { allow read: if isAdmin() && hasPermission('finance.read'); allow write: if false; }
    match /adminAuditEvents/{eventId} { allow read: if isAdmin() && hasPermission('audit.read'); allow write: if false; }
    match /reportingAggregates/{aggregateId} { allow read, write: if false; }
    match /products/{productId} { allow read: if isAuth(); allow write: if false; }
    match /productSales/{saleId} { allow read: if isAdmin(); allow write: if false; }
    match /cleanerInventory/{inventoryId} { allow read: if isAdmin() || (isAuth() && resource.data.cleanerId == request.auth.uid); allow write: if false; }

    // Deny everything else
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
