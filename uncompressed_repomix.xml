 useEffect(()=>{loadBetaConfig().then(setConfig); if(existingConsent()==='yes')setAnalyticsConsent(true); const observer=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){track('section_view',{section:(e.target as HTMLElement).id});observer.unobserve(e.target)}}),{threshold:.35}); document.querySelectorAll('main section[id]').forEach(s=>observer.observe(s)); return()=>observer.disconnect()},[]);
 if(location.pathname==='/privacy') return <Legal type="privacy"/>; if(location.pathname==='/terms') return <Legal type="terms"/>;
 const cta=(label:string)=><a className="primary" href="#join" onClick={()=>track('cta_click',{label})}>{label}<ArrowRight size={18}/></a>;
 return <><a className="skip" href="#main">Skip to content</a><header><a className="logo" href="#top" aria-label="Detail home"><BrandMark/>DETAIL</a><nav aria-label="Primary"><a href="#how">How it works</a><a href="#services">Services</a><a href="#cleaners">For cleaners</a><a href="#faq">FAQs</a></nav><a className="nav-cta" href="#join">Join waitlist</a></header>
