  safeBottom?: boolean;
  className?: string;
}

export function GlassSheet({
  variant = 'light',
  safeBottom = true,
  style,
  className,
  children,
  ...rest
}: GlassSheetProps) {
  const insets = useSafeAreaInsets();

  return (
    <View
