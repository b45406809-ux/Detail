          StyleSheet.absoluteFill,
          {
            backgroundColor:
              variant === 'light' ? 'rgba(255,255,255,0.62)' : 'rgba(13,10,36,0.68)',
          },
        ]}
      />
      <View style={styles.handle} />
      {children}
