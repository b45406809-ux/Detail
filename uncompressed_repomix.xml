<file path=".github/workflows/deploy-supabase.yml">
name: Deploy Supabase backend

on:
  push:
    branches: [main]
    paths:
      - supabase/**
      - .github/workflows/deploy-supabase.yml
  workflow_dispatch:

permissions:
  contents: read

jobs:
  deploy:
    if: ${{ vars.SUPABASE_PROJECT_REF != '' }}
    runs-on: ubuntu-latest
    environment: production
    env:
      SUPABASE_ACCESS_TOKEN: ${{ secrets.SUPABASE_ACCESS_TOKEN }}
      SUPABASE_PROJECT_REF: ${{ vars.SUPABASE_PROJECT_REF }}
      SUPABASE_DB_PASSWORD: ${{ secrets.SUPABASE_DB_PASSWORD }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 20
      - name: Link and apply database migrations
        run: |
          npx --yes supabase@latest link --project-ref "$SUPABASE_PROJECT_REF" --password "$SUPABASE_DB_PASSWORD"
          npx --yes supabase@latest db push
      - name: Deploy marketplace and provider functions
        run: |
          npx --yes supabase@latest functions deploy marketplace-api --project-ref "$SUPABASE_PROJECT_REF"
          npx --yes supabase@latest functions deploy paynow-webhook --project-ref "$SUPABASE_PROJECT_REF"
          npx --yes supabase@latest functions deploy paynow-return --project-ref "$SUPABASE_PROJECT_REF"
          npx --yes supabase@latest functions deploy marketing-unsubscribe --project-ref "$SUPABASE_PROJECT_REF"
</file>

<file path=".github/workflows/notification-delivery.yml">
name: Detail notification delivery

on:
  schedule:
    - cron: '*/5 * * * *'
  workflow_dispatch:

concurrency:
  group: notification-delivery
  cancel-in-progress: false

jobs:
  deliver:
    runs-on: ubuntu-latest
    steps:
      - name: Check worker secrets
        id: config
        env:
          SUPABASE_URL: ${{ secrets.SUPABASE_URL }}
          CRON_SECRET: ${{ secrets.CRON_SECRET }}
        run: |
          if [ -n "$SUPABASE_URL" ] && [ -n "$CRON_SECRET" ]; then
            echo "ready=true" >> "$GITHUB_OUTPUT"
          else
            echo "ready=false" >> "$GITHUB_OUTPUT"
            echo "Set the SUPABASE_URL and CRON_SECRET repository secrets to enable delivery."
          fi
      - name: Process notification deliveries and Expo receipts
        if: steps.config.outputs.ready == 'true'
        env:
          SUPABASE_URL: ${{ secrets.SUPABASE_URL }}
          CRON_SECRET: ${{ secrets.CRON_SECRET }}
        run: |
          curl --fail-with-body --silent --show-error \
            --request POST "$SUPABASE_URL/functions/v1/delivery-worker" \
            --header "x-scheduler-secret: $CRON_SECRET" \
            --header "content-type: application/json" \
            --data '{}'
</file>

