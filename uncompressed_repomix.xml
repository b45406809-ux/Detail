const steps = [['01','Request','Tell us what needs cleaning, where and when.'],['02','Compare bids','Review transparent offers from available cleaners.'],['03','Pay securely','Confirm your choice with protected payment.'],['04','Track','Follow arrival and job progress in the app.'],['05','Complete','Release payment only when the work is done.'],['06','Rate','Share feedback that strengthens the community.']];

function Waitlist({ enabled, id = 'waitlist' }: { enabled: boolean; id?: string }) {
