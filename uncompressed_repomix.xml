import { useEffect, useState } from 'react';
import { Copy, KeyRound, UserPlus } from 'lucide-react';
import { supabase } from '../supabase';
import { adminCall } from './api';

interface Directory { admins:Array<{uid:string;email:string;disabled:boolean;elevated:boolean;permissions:string[];lastSignInAt:string|null}>; invites:Array<{id:string;email:string;status:string;permissions:string[];createdAt:string;expiresAt:string}> }
const permissions=['marketing.read','marketing.send','finance.read','finance.write','bookings.manage','users.manage','support.manage','audit.read','admins.manage'];

export function Admins(){const [directory,setDirectory]=useState<Directory>({admins:[],invites:[]});const [email,setEmail]=useState('');const [selected,setSelected]=useState<string[]>(['marketing.read']);const [link,setLink]=useState('');const [error,setError]=useState('');const [busy,setBusy]=useState(false);const [currentPassword,setCurrentPassword]=useState('');const [newPassword,setNewPassword]=useState('');
  const load=()=>adminCall<Directory>('adminDirectory').then(setDirectory).catch(error=>setError(error.message));useEffect(()=>{void load()},[]);
  const invite=async()=>{setBusy(true);setError('');try{const result=await adminCall<{inviteUrl:string}>('createAdminInvite',{email,permissions:selected});setLink(result.inviteUrl);setEmail('');load()}catch(error){setError((error as Error).message)}finally{setBusy(false)}};
  const changePassword=async()=>{const {data:{user}}=await supabase.auth.getUser();if(!user?.email)return setError('Password changes require an email/password account.');setBusy(true);setError('');try{const reauth=await supabase.auth.signInWithPassword({email:user.email,password:currentPassword});if(reauth.error)throw reauth.error;const result=await supabase.auth.updateUser({password:newPassword});if(result.error)throw result.error;setCurrentPassword('');setNewPassword('');alert('Password changed successfully.')}catch(error){setError((error as Error).message)}finally{setBusy(false)}};
  return <section><header className="module-header"><div><h1>Admins & Security</h1><p>Invite administrators manually and manage your own password</p></div></header>{error&&<div className="inline-error">{error}</div>}<div className="admin-two-column"><article className="panel campaign"><div className="panel-title"><h2>Create manual invite</h2><UserPlus size={20}/></div><label>Invite email<input type="email" value={email} onChange={event=>setEmail(event.target.value)} placeholder="admin@example.com"/></label><fieldset><legend>Permissions</legend>{permissions.map(permission=><label className="permission-check" key={permission}><input type="checkbox" checked={selected.includes(permission)} onChange={event=>setSelected(event.target.checked?[...selected,permission]:selected.filter(value=>value!==permission))}/>{permission}</label>)}</fieldset><button onClick={invite} disabled={busy||!email}>Create invite link</button>{link&&<div className="invite-result"><input readOnly value={link}/><button onClick={()=>navigator.clipboard.writeText(link)}><Copy size={15}/> Copy link</button><small>Send this link manually. It expires in seven days and is restricted to the entered email.</small></div>}</article><article className="panel campaign"><div className="panel-title"><h2>Change my password</h2><KeyRound size={20}/></div><label>Current password<input type="password" autoComplete="current-password" value={currentPassword} onChange={event=>setCurrentPassword(event.target.value)}/></label><label>New password<input type="password" autoComplete="new-password" minLength={8} value={newPassword} onChange={event=>setNewPassword(event.target.value)}/></label><button onClick={changePassword} disabled={busy||!currentPassword||newPassword.length<8}>Update password</button><small className="muted">Supabase requires a recent sign-in. Passwords are never stored in application code.</small></article></div><article className="panel"><h2>Current administrators</h2><div className="table-wrap"><table><thead><tr><th>Email</th><th>Elevated</th><th>Permissions</th><th>Last sign-in</th></tr></thead><tbody>{directory.admins.map(admin=><tr key={admin.uid}><td>{admin.email}</td><td>{admin.elevated?'Yes':'No'}</td><td>{admin.permissions.join(', ')||'Basic admin'}</td><td>{admin.lastSignInAt||'—'}</td></tr>)}</tbody></table></div></article><article className="panel"><h2>Invitation history</h2><div className="table-wrap"><table><thead><tr><th>Email</th><th>Status</th><th>Permissions</th><th>Expires</th></tr></thead><tbody>{directory.invites.map(invite=><tr key={invite.id}><td>{invite.email}</td><td>{invite.status}</td><td>{invite.permissions.join(', ')}</td><td>{invite.expiresAt?new Date(invite.expiresAt).toLocaleString():'—'}</td></tr>)}</tbody></table></div></article></section>}
