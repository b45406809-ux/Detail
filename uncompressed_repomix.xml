<file path="mobile/services/emailAuth.ts">
import { IS_MOCK } from '../utils/env';
import { supabase } from './supabase';

export async function sendEmailLoginCode(email: string, intent: 'SIGN_IN' | 'REGISTER', termsAccepted: boolean) {
  if (IS_MOCK) {
    await new Promise((resolve) => setTimeout(resolve, 500));
    return;
  }
  const { error } = await supabase.auth.signInWithOtp({ email: email.trim().toLowerCase(), options: { shouldCreateUser: intent === 'REGISTER', data: intent === 'REGISTER' ? { termsAccepted } : undefined } });
  if (error) throw error;
}

export async function confirmEmailLoginCode(email: string, code: string, intent: 'SIGN_IN' | 'REGISTER') {
  if (IS_MOCK) {
    if (!/^\d{6}$/.test(code)) throw new Error('Enter a six-digit code.');
    const { error } = await supabase.auth.signInAnonymously();
    if (error) throw error;
    return;
  }
  const { data, error } = await supabase.auth.verifyOtp({ email: email.trim().toLowerCase(), token: code, type: intent === 'REGISTER' ? 'signup' : 'email' });
  if (error) throw error;
  if (!data.user) throw new Error('Verification did not return an account.');
}
</file>

<file path="mobile/services/locationTracking.ts">
import * as Location from 'expo-location';
import * as TaskManager from 'expo-task-manager';
import { callFunction } from './functions';

export const CLEANER_LOCATION_TASK='detail-cleaner-location';

TaskManager.defineTask(CLEANER_LOCATION_TASK, async ({data,error})=>{
  if(error||!data)return;
  const locations=(data as {locations?:Location.LocationObject[]}).locations;
  const newest=locations?.at(-1);
  if(!newest)return;
  try{await callFunction('updateCleanerLocation',{lat:newest.coords.latitude,lng:newest.coords.longitude});}
  catch(e){console.warn('[location] cleaner update failed',String(e));}
});

export async function startCleanerLocationUpdates(){
  const foreground=await Location.requestForegroundPermissionsAsync();
  if(!foreground.granted)throw new Error('Allow location while using Detail to go online.');
  const background=await Location.requestBackgroundPermissionsAsync();
  if(!background.granted)throw new Error('Allow background location while online so nearby customers can receive accurate availability and active-job updates.');
  if(await TaskManager.isTaskRegisteredAsync(CLEANER_LOCATION_TASK))return;
  await Location.startLocationUpdatesAsync(CLEANER_LOCATION_TASK,{
    accuracy:Location.Accuracy.Balanced,timeInterval:15000,distanceInterval:50,
    pausesUpdatesAutomatically:true,showsBackgroundLocationIndicator:true,
    foregroundService:{notificationTitle:'Detail cleaner availability is on',notificationBody:'Your location is shared while you are online and during an active booking.',notificationColor:'#3906d2'},
  });
}

export async function stopCleanerLocationUpdates(){
  if(await TaskManager.isTaskRegisteredAsync(CLEANER_LOCATION_TASK))await Location.stopLocationUpdatesAsync(CLEANER_LOCATION_TASK);
}
</file>

<file path="mobile/services/mapbox.ts">
import Constants from 'expo-constants';
import { Platform } from 'react-native';

export const MAPBOX_ACCESS_TOKEN = String(Constants.expoConfig?.extra?.mapboxAccessToken ?? '');
export const IS_MAPBOX_AVAILABLE = Platform.OS !== 'web' && Boolean(MAPBOX_ACCESS_TOKEN)
  && Constants.executionEnvironment !== 'storeClient';

// Mapbox's native entry point throws during import in Expo Go. Load it only
// in a custom native build; type-only import keeps the app's fallback usable.
type MapboxModule = typeof import('@rnmapbox/maps').default;
export const Mapbox = (IS_MAPBOX_AVAILABLE ? require('@rnmapbox/maps').default : null) as MapboxModule;

export async function getDrivingRoute(origin:{lat:number;lng:number},destination:{lat:number;lng:number}){
  if(!MAPBOX_ACCESS_TOKEN)throw new Error('Mapbox directions are not configured.');
  const coordinates=`${origin.lng},${origin.lat};${destination.lng},${destination.lat}`;
  const url=`https://api.mapbox.com/directions/v5/mapbox/driving/${coordinates}?overview=full&geometries=geojson&access_token=${encodeURIComponent(MAPBOX_ACCESS_TOKEN)}`;
  const response=await fetch(url);if(!response.ok)throw new Error(`Mapbox directions returned ${response.status}.`);
  const body=await response.json();const route=body.routes?.[0];
  if(!route||!Number.isFinite(route.duration)||!Array.isArray(route.geometry?.coordinates))throw new Error('No driving route is available.');
  return {durationMinutes:Math.max(1,Math.round(route.duration/60)),distanceKm:Number(route.distance)/1000,coordinates:route.geometry.coordinates as [number,number][]};
}

if (IS_MAPBOX_AVAILABLE) {
  void Mapbox.setAccessToken(MAPBOX_ACCESS_TOKEN);
}
</file>

<file path="mobile/services/supabase.ts">
import AsyncStorage from '@react-native-async-storage/async-storage';
import { createClient, type SupabaseClient, type User as SupabaseUser } from '@supabase/supabase-js';
import { signMediaValue } from './storage';

const supabaseUrl = process.env.EXPO_PUBLIC_SUPABASE_URL ?? '';
const supabaseAnonKey = process.env.EXPO_PUBLIC_SUPABASE_ANON_KEY ?? '';
if (!supabaseUrl || !supabaseAnonKey) console.warn('Supabase is not configured. Set EXPO_PUBLIC_SUPABASE_URL and EXPO_PUBLIC_SUPABASE_ANON_KEY.');

export const supabase = createClient(supabaseUrl || 'http://127.0.0.1:54321', supabaseAnonKey || 'local-anon-key', {
  auth: { storage: AsyncStorage, autoRefreshToken: true, persistSession: true, detectSessionInUrl: false, flowType: 'pkce' },
});

export interface SupabaseCompatUser {
  uid: string;
  email: string | null;
  emailVerified: boolean;
  phoneNumber?: string;
  displayName?: string;
  photoURL?: string;
  getIdToken: (forceRefresh?: boolean) => Promise<string>;
  getIdTokenResult: (forceRefresh?: boolean) => Promise<{ claims: Record<string, unknown> }>;
  reload: () => Promise<void>;
  _user: SupabaseUser;
}

function compatUser(user: SupabaseUser | null): SupabaseCompatUser | null {
  if (!user) return null;
  const profile = user.user_metadata ?? {};
  return {
    uid: user.id,
    email: user.email ?? null,
    emailVerified: !!user.email_confirmed_at,
    phoneNumber: user.phone ?? undefined,
    displayName: typeof profile.displayName === 'string' ? profile.displayName : undefined,
    photoURL: typeof profile.avatar_url === 'string' ? profile.avatar_url : undefined,
    _user: user,
    getIdToken: async () => {
      const { data, error } = await supabase.auth.getSession();
      if (error || !data.session) throw error ?? new Error('Sign in required.');
      return data.session.access_token;
    },
    getIdTokenResult: async () => {
      const { data, error } = await supabase.auth.getSession();
      if (error || !data.session) throw error ?? new Error('Sign in required.');
      return { claims: { ...data.session.user.app_metadata, ...data.session.user.user_metadata } };
    },
    reload: async () => { await supabase.auth.getUser(); },
  };
}

export const auth = {
  get currentUser(): SupabaseCompatUser | null { return compatUser(currentAuthUser); },
};
let currentAuthUser: SupabaseUser | null = null;
supabase.auth.getSession().then(({ data }) => { currentAuthUser = data.session?.user ?? null; }).catch(() => {});
supabase.auth.onAuthStateChange((_event, session) => { currentAuthUser = session?.user ?? null; });

export function onAuthStateChanged(_auth: typeof auth, callback: (user: SupabaseCompatUser | null) => void) {
  let active = true;
  supabase.auth.getSession().then(({ data }) => { if (active) callback(compatUser(data.session?.user ?? null)); });
  const { data: { subscription } } = supabase.auth.onAuthStateChange((_event, session) => {
    currentAuthUser = session?.user ?? null;
    callback(compatUser(session?.user ?? null));
  });
  return () => { active = false; subscription.unsubscribe(); };
}

