name: Generate Repomix Compressed Output

on:
  workflow_dispatch: # Allows you to manually trigger it from the GitHub "Actions" tab
  push:
    branches:
      - codex/separate-dashboard-into-routed-modules-fl7jlh

permissions:
  contents: write # Needed to commit and push changes back to the repo

jobs:
  repomix:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          ref: codex/separate-dashboard-into-routed-modules-fl7jlh
          fetch-depth: 0

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Run Repomix with compression
        run: npx --yes repomix --output uncompressed_repomix.xml --ignore "**/*.xml"
        

      - name: Commit and push Repomix output
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

          # Stage any output file generated by Repomix (e.g. repomix-output.txt, .xml, .md)
          git add uncompressed_repomix.*

          if git diff --staged --quiet; then
            echo "No changes detected in repomix output."
          else
            git commit -m "chore: update repomix output [skip ci]"
            git push origin codex/separate-dashboard-into-routed-modules-fl7jlh
          fi
