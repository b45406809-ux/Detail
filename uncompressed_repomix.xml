<file path="mobile/app/(tabs)/wallet.tsx">
import React, { useEffect, useState } from 'react';
import {
  View,
  Text,
  FlatList,
  TouchableOpacity,
  Modal,
  TextInput,
  ActivityIndicator,
  Alert,
} from 'react-native';
import { SafeAreaView } from 'react-native-safe-area-context';
import {
  ArrowUpRight,
  ArrowDownLeft,
  Plus,
  X,
  Smartphone,
  CreditCard,
  Wallet,
} from 'lucide-react-native';
import { useAuth } from '../../context/AuthContext';
import {
  db,
  collection,
  query,
  where,
  onSnapshot,
  orderBy,
  limit,
} from '../../services/firebase';
import { addFundsToWallet, getPaymentMethods } from '../../services/payments';
import { IS_MOCK } from '../../utils/env';
import { WalletTransaction } from '../../types';

const METHOD_ICONS: Record<string, any> = {
  ecocash: Smartphone,
  card: CreditCard,
};

export default function WalletScreen() {
  const { user, profile } = useAuth();
  const [transactions, setTransactions] = useState<WalletTransaction[]>([]);
  const [isAddFundsOpen, setIsAddFundsOpen] = useState(false);
  const [amount, setAmount] = useState('');
  const [isLoading, setIsLoading] = useState(false);

  const paymentMethods = getPaymentMethods();

  // Real-time transaction feed from Firestore
  useEffect(() => {
    if (!user) return;
    const q = query(
      collection(db, 'transactions'),
      where('userId', '==', user.uid),
      orderBy('createdAt', 'desc'),
      limit(20)
    );
    return onSnapshot(q, (snap) => {
      setTransactions(snap.docs.map((d) => ({ id: d.id, ...d.data() } as WalletTransaction)));
    });
  }, [user]);

  const handleAddFunds = async () => {
    const value = parseFloat(amount);
    if (isNaN(value) || value < 1) {
      Alert.alert('Invalid amount', 'Minimum top-up is $1.00');
      return;
    }
    setIsLoading(true);
    try {
      // DEV:  simulates payment + writes real Firestore transaction + increments balance
      // PROD: opens PesePay hosted checkout; balance updates via Firestore webhook
      const result = await addFundsToWallet(value);
      setIsAddFundsOpen(false);
      setAmount('');

      if (IS_MOCK) {
        Alert.alert('[DEV] Simulated', `$${value.toFixed(2)} added to your wallet (no real charge).`);
      } else if (result.pending) {
        Alert.alert(
          'Payment Processing',
          'Your payment is being confirmed. Your balance will update automatically once the transaction is complete.'
        );
      }
    } catch (err: any) {
      if (err.message !== 'CANCELED') {
        Alert.alert('Payment Failed', err.message || 'Please try again.');
      }
    } finally {
      setIsLoading(false);
    }
  };

  const balance = profile?.balance ?? 0;

  return (
    <SafeAreaView className="flex-1 bg-[#F2F1F5]">
      {/* Header */}
      <View className="px-5 pt-4 pb-4">
        <Text className="text-2xl font-black text-slate-900 tracking-tight">Wallet</Text>
      </View>

      {/* Balance card */}
      <View className="mx-5 mb-6 bg-accent rounded-4xl p-6 shadow-xl shadow-accent/30">
        <View className="flex-row items-center gap-2 mb-4">
          <Wallet size={18} color="rgba(255,255,255,0.7)" />
          <Text className="text-xs font-black text-white/70 uppercase tracking-widest">
            Available Balance
          </Text>
        </View>
        <Text className="text-4xl font-black text-white mb-1">${balance.toFixed(2)}</Text>
        <Text className="text-sm text-white/60 font-medium">Detail Wallet</Text>

        <View className="flex-row gap-3 mt-6">
          <TouchableOpacity
            onPress={() => setIsAddFundsOpen(true)}
            className="flex-1 bg-white/20 py-3 rounded-2xl flex-row items-center justify-center gap-2"
            activeOpacity={0.8}
          >
            <Plus size={16} color="#fff" />
            <Text className="text-white font-black text-xs uppercase tracking-wider">Add Funds</Text>
          </TouchableOpacity>
          <TouchableOpacity
            onPress={() =>
              Alert.alert(
                'Withdraw',
                'Withdrawals are processed within 1–3 business days to your linked account. Contact support to initiate.'
              )
            }
            className="flex-1 bg-white/20 py-3 rounded-2xl flex-row items-center justify-center gap-2"
            activeOpacity={0.8}
          >
            <ArrowUpRight size={16} color="#fff" />
            <Text className="text-white font-black text-xs uppercase tracking-wider">Withdraw</Text>
          </TouchableOpacity>
        </View>
      </View>

      {balance < 0 && (
        <TouchableOpacity
          onPress={() => setIsAddFundsOpen(true)}
          activeOpacity={0.85}
          className="mx-5 mb-6 bg-red-50 border border-red-100 rounded-3xl p-4 flex-row items-center gap-3"
        >
          <View className="w-10 h-10 bg-red-100 rounded-2xl items-center justify-center">
            <ArrowUpRight size={18} color="#ef4444" />
          </View>
          <View className="flex-1">
            <Text className="text-sm font-black text-red-700">Outstanding commission balance</Text>
            <Text className="text-xs text-red-500 font-medium mt-0.5">
              Add funds to bring your balance to $0 and keep bidding on jobs
            </Text>
          </View>
        </TouchableOpacity>
      )}

      {/* Payment methods (informational — the processor handles selection on its hosted page) */}
      <View className="mx-5 mb-6">
        <Text className="text-xs font-black text-slate-400 uppercase tracking-widest mb-3">
          Accepted Payment Methods
          {IS_MOCK && <Text className="text-amber-500"> [DEV — simulated]</Text>}
        </Text>
        <View className="bg-white rounded-3xl border border-slate-100 overflow-hidden">
          {paymentMethods.map(({ id, label, sub }, idx) => {
            const Icon = METHOD_ICONS[id] ?? CreditCard;
            return (
              <View
                key={id}
                className={`flex-row items-center gap-4 px-5 py-4 ${
                  idx < paymentMethods.length - 1 ? 'border-b border-slate-50' : ''
                }`}
              >
                <View className="w-10 h-10 bg-accent/10 rounded-2xl items-center justify-center">
                  <Icon size={18} color="#3906d2" />
                </View>
                <View className="flex-1">
                  <Text className="text-sm font-black text-slate-900">{label}</Text>
                  <Text className="text-xs text-slate-400 font-medium mt-0.5">{sub}</Text>
                </View>
              </View>
            );
          })}
        </View>
      </View>

      {/* Transactions */}
      <View className="flex-1 px-5">
        <Text className="text-xs font-black text-slate-400 uppercase tracking-widest mb-3">
          Recent Transactions
        </Text>
        {transactions.length === 0 ? (
          <View className="bg-white rounded-3xl p-8 items-center border border-slate-100">
            <Text className="text-3xl mb-3">💳</Text>
            <Text className="text-sm font-black text-slate-600 text-center">
              No transactions yet
            </Text>
          </View>
        ) : (
          <FlatList
            data={transactions}
            keyExtractor={(t) => t.id}
            showsVerticalScrollIndicator={false}
            contentContainerClassName="gap-3"
            renderItem={({ item }) => (
              <View className="bg-white rounded-3xl p-4 flex-row items-center gap-4 border border-slate-100">
                <View
                  className={`w-12 h-12 rounded-2xl items-center justify-center ${
                    item.type === 'CREDIT' ? 'bg-emerald-50' : 'bg-red-50'
                  }`}
                >
                  {item.type === 'CREDIT' ? (
                    <ArrowDownLeft size={22} color="#10b981" />
                  ) : (
                    <ArrowUpRight size={22} color="#ef4444" />
                  )}
                </View>
                <View className="flex-1">
                  <Text className="text-sm font-black text-slate-900">{item.description}</Text>
                  <Text className="text-xs text-slate-400 font-medium mt-0.5">
                    {item.createdAt?.toDate?.()?.toLocaleDateString() ?? 'Recent'}
                  </Text>
                </View>
                <View className="items-end">
                  <Text
                    className={`text-base font-black ${
                      item.type === 'CREDIT' ? 'text-emerald-600' : 'text-red-500'
                    }`}
                  >
                    {item.type === 'CREDIT' ? '+' : '-'}${item.amount.toFixed(2)}
                  </Text>
                  {(item as any).status === 'PENDING' && (
                    <Text className="text-[10px] font-black text-amber-500 uppercase tracking-wider mt-0.5">
                      Pending
                    </Text>
                  )}
                </View>
              </View>
            )}
          />
        )}
      </View>

      {/* Add Funds Modal */}
      <Modal visible={isAddFundsOpen} transparent animationType="slide">
        <View className="flex-1 justify-end">
          <TouchableOpacity
            className="flex-1 bg-black/50"
            onPress={() => setIsAddFundsOpen(false)}
          />
          <View className="bg-white rounded-t-[32px] p-6 pb-10">
            <View className="flex-row items-center justify-between mb-1">
              <Text className="text-xl font-black text-slate-900">Add Funds</Text>
              <TouchableOpacity onPress={() => setIsAddFundsOpen(false)}>
                <X size={22} color="#94a3b8" />
              </TouchableOpacity>
            </View>
            <Text className="text-xs text-slate-400 font-medium mb-6">
              {IS_MOCK ? 'DEV mode — no real charge' : 'Secure payment · EcoCash, Card & more'}
            </Text>

            <Text className="text-xs font-black text-slate-500 uppercase tracking-widest mb-2">
              Amount (USD)
            </Text>
            <TextInput
              className="border-2 border-slate-100 rounded-2xl px-4 py-4 text-2xl font-black text-slate-900 bg-slate-50 mb-4"
              placeholder="0.00"
              placeholderTextColor="#94a3b8"
              keyboardType="decimal-pad"
              value={amount}
              onChangeText={setAmount}
              autoFocus
            />

            {/* Quick-amount chips */}
            <View className="flex-row gap-2 mb-5">
              {['5', '10', '25', '50'].map((preset) => (
                <TouchableOpacity
                  key={preset}
                  onPress={() => setAmount(preset)}
                  className={`flex-1 py-2.5 rounded-2xl items-center border ${
                    amount === preset ? 'bg-accent border-accent' : 'bg-slate-50 border-slate-100'
                  }`}
                >
                  <Text
                    className={`text-xs font-black ${
                      amount === preset ? 'text-white' : 'text-slate-600'
                    }`}
                  >
                    ${preset}
                  </Text>
                </TouchableOpacity>
              ))}
            </View>

            <TouchableOpacity
              onPress={handleAddFunds}
              disabled={isLoading || !amount}
              className="bg-accent py-5 rounded-[32px] items-center shadow-lg shadow-accent/30"
              activeOpacity={0.85}
            >
              {isLoading ? (
                <ActivityIndicator color="#fff" />
              ) : (
                <Text className="text-white font-black text-sm uppercase tracking-widest">
                  {IS_MOCK ? `[DEV] Add $${amount || '0.00'}` : `Pay $${amount || '0.00'}`}
                </Text>
              )}
            </TouchableOpacity>
          </View>
        </View>
      </Modal>
    </SafeAreaView>
  );
}
</file>

<file path="mobile/services/firebase.ts">
import { initializeApp, getApps } from 'firebase/app';
import {
  getAuth,
  onAuthStateChanged,
  signInWithEmailAndPassword,
  createUserWithEmailAndPassword,
  signOut,
  signInAnonymously,
  signInWithCredential,
  sendEmailVerification,
  sendPasswordResetEmail,
  GoogleAuthProvider,
  OAuthProvider,
  User as FirebaseUser,
  initializeAuth,
  getReactNativePersistence,
  connectAuthEmulator,
} from 'firebase/auth';
import {
  getFirestore,
  doc,
  getDoc,
  setDoc,
  updateDoc,
  deleteDoc,
  collection,
  query,
  where,
  onSnapshot,
  getDocs,
  addDoc,
  orderBy,
  limit,
  serverTimestamp,
  Timestamp,
  collectionGroup,
  getDocFromServer,
  increment,
  runTransaction,
  writeBatch,
  connectFirestoreEmulator,
} from 'firebase/firestore';
import AsyncStorage from '@react-native-async-storage/async-storage';

// Firebase configuration — exported so RecaptchaModal (phone-auth OTP) can consume it
export const firebaseConfig = {
  apiKey: process.env.EXPO_PUBLIC_FIREBASE_API_KEY ?? '',
  authDomain: process.env.EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN ?? '',
  projectId: process.env.EXPO_PUBLIC_FIREBASE_PROJECT_ID ?? '',
  storageBucket: process.env.EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET ?? '',
  messagingSenderId: process.env.EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID ?? '',
  appId: process.env.EXPO_PUBLIC_FIREBASE_APP_ID ?? '',
  databaseURL: process.env.EXPO_PUBLIC_FIREBASE_DATABASE_URL,
};

const firestoreDatabaseId = process.env.EXPO_PUBLIC_FIRESTORE_DATABASE_ID;

// Prevent re-initialization during hot reload
const app = getApps().length === 0 ? initializeApp(firebaseConfig) : getApps()[0];

// Use AsyncStorage for auth persistence on native
export const auth = initializeAuth(app, {
  persistence: getReactNativePersistence(AsyncStorage),
});

export const db = getFirestore(app, firestoreDatabaseId ?? '(default)');

// Point at local emulators for development so the app runs the real server code
// (Cloud Functions, security rules) instead of any client-side shortcut.
if (process.env.EXPO_PUBLIC_USE_FIREBASE_EMULATOR === 'true') {
  const host = process.env.EXPO_PUBLIC_EMULATOR_HOST ?? 'localhost';
  try {
    connectAuthEmulator(auth, `http://${host}:9099`, { disableWarnings: true });
    connectFirestoreEmulator(db, host, 8080);
  } catch {
    // Already connected (hot reload) — ignore.
  }
}

export enum OperationType {
  CREATE = 'create',
  UPDATE = 'update',
  DELETE = 'delete',
  LIST = 'list',
  GET = 'get',
  WRITE = 'write',
}

export function handleFirestoreError(
  error: unknown,
  operationType: OperationType,
  path: string | null
) {
  const errorMsg = error instanceof Error ? error.message : String(error);
  console.error('Firestore Error:', { operationType, path, error: errorMsg });
  throw new Error(errorMsg);
}

export async function testFirestoreConnection() {
  try {
    await getDocFromServer(doc(db, 'test', 'connection'));
  } catch {
    // Connection test — errors are expected for missing docs
  }
}

export {
  doc,
  getDoc,
  setDoc,
  updateDoc,
  deleteDoc,
  collection,
  query,
  where,
  onSnapshot,
  getDocs,
  addDoc,
  orderBy,
  limit,
  serverTimestamp,
  Timestamp,
  collectionGroup,
  onAuthStateChanged,
  signInWithEmailAndPassword,
  createUserWithEmailAndPassword,
  signOut,
  signInAnonymously,
  signInWithCredential,
  sendEmailVerification,
  sendPasswordResetEmail,
  GoogleAuthProvider,
  OAuthProvider,
  increment,
  runTransaction,
  writeBatch,
};
export type { FirebaseUser };
</file>

<file path="mobile/app/job/[jobId].tsx">
import React, { useEffect, useState } from 'react';
import {
  View,
  Text,
  TouchableOpacity,
  ScrollView,
  TextInput,
  ActivityIndicator,
  Alert,
  KeyboardAvoidingView,
  Platform,
  Image,
  Modal,
} from 'react-native';
import { SafeAreaView } from 'react-native-safe-area-context';
import { router, useLocalSearchParams } from 'expo-router';
import { ArrowLeft, MapPin, Clock, DollarSign, MessageSquare, Hash, Home, Layers, Sparkles, X } from 'lucide-react-native';
import { useAuth } from '../../context/AuthContext';
import { db, doc, collection, onSnapshot, query, where, getDocs, limit } from '../../services/firebase';
import { callFunction } from '../../services/functions';
import { Job, JobStatus, HouseChecklist, CarChecklist } from '../../types';
import { IS_MOCK } from '../../utils/env';
import { haversineDistanceKm } from '../../services/matching';
import * as Location from 'expo-location';

export default function CleanerJobDetailScreen() {
  const { jobId } = useLocalSearchParams<{ jobId: string }>();
  const { user, profile } = useAuth();
  const [job, setJob] = useState<Job | null>(null);
  const [isLoading, setIsLoading] = useState(true);
  const [alreadyBid, setAlreadyBid] = useState(false);
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [selectedPhotoUrl, setSelectedPhotoUrl] = useState<string | null>(null);

  const [bidPrice, setBidPrice] = useState('');
  const [estimatedArrival, setEstimatedArrival] = useState('');
  const [message, setMessage] = useState('');

  const [currentLocation, setCurrentLocation] = useState<{ lat: number; lng: number } | null>(null);

  useEffect(() => {
    Location.getCurrentPositionAsync({ accuracy: Location.Accuracy.Balanced })
      .then(({ coords }) => setCurrentLocation({ lat: coords.latitude, lng: coords.longitude }))
      .catch(() => {});
  }, []);

  useEffect(() => {
    if (!jobId) return;
    return onSnapshot(
      doc(db, 'jobs', jobId),
      (snap) => {
        if (snap.exists()) setJob({ id: snap.id, ...snap.data() } as Job);
        setIsLoading(false);
      },
      () => setIsLoading(false)
    );
  }, [jobId]);

  useEffect(() => {
    if (!jobId || !user) return;
    const q = query(collection(db, 'bids'), where('jobId', '==', jobId), where('cleanerId', '==', user.uid), limit(1));
    getDocs(q).then((snap) => setAlreadyBid(!snap.empty));
  }, [jobId, user]);

  const handleSubmitBid = async () => {
    const price = parseFloat(bidPrice);
    const eta = parseInt(estimatedArrival, 10);

    if (isNaN(price) || price < 1) {
      Alert.alert('Invalid Price', 'Please enter a valid bid price.');
      return;
    }
    if (isNaN(eta) || eta < 1 || eta > 120) {
      Alert.alert('Invalid ETA', 'Please enter an estimated arrival time in minutes (1–120).');
      return;
    }
    if (!user || !profile) return;
    if (job?.status !== JobStatus.PENDING) {
      Alert.alert('Too Late', 'This job is no longer accepting bids.');
      return;
    }

    setIsSubmitting(true);
    try {
      await callFunction('submitBid', {
        jobId,
        bidPrice: price,
        estimatedArrival: eta,
        message: message.trim() || undefined,
      });
      setAlreadyBid(true);
      Alert.alert('Bid Placed!', "Your offer has been sent to the customer. You'll be notified if they accept.");
    } catch (err: any) {
      Alert.alert('Error', err.message || 'Failed to submit bid. Please try again.');
    } finally {
      setIsSubmitting(false);
    }
  };

  if (isLoading) {
    return (
      <View className="flex-1 items-center justify-center bg-white">
        <ActivityIndicator color="#3906D2" size="large" />
      </View>
    );
  }

  if (!job) {
    return (
      <SafeAreaView className="flex-1 bg-white items-center justify-center px-6">
        <Text className="text-lg font-black text-ink text-center">Job not found</Text>
        <TouchableOpacity onPress={() => router.back()} className="mt-4">
          <Text className="text-accent font-black">Go Back</Text>
        </TouchableOpacity>
      </SafeAreaView>
    );
  }

  const isTaken = job.status !== JobStatus.PENDING;
  const distance = IS_MOCK
    ? '2.3 km away'
    : currentLocation && job.location?.lat && job.location?.lng
    ? `${haversineDistanceKm(currentLocation, { lat: job.location.lat, lng: job.location.lng }).toFixed(1)} km away`
    : null;

  const budgetLabel = job.budget ? `$${job.budget}` : 'Open — send your best price';

  const checklistTags = getChecklistTags(job);

  return (
    <SafeAreaView className="flex-1 bg-[#F3F1FC]">
      <KeyboardAvoidingView className="flex-1" behavior={Platform.OS === 'ios' ? 'padding' : 'height'}>
        <View className="flex-row items-center gap-3 px-5 pt-4 pb-4">
          <TouchableOpacity onPress={() => router.back()} className="w-10 h-10 bg-white rounded-2xl items-center justify-center border border-ink/5">
            <ArrowLeft size={18} color="#150256" />
          </TouchableOpacity>
          <View className="flex-1">
            <Text className="text-xl font-black text-ink">{job.serviceType}</Text>
            <Text className="text-xs text-ink/40 font-medium">#{jobId?.slice(-6).toUpperCase()}</Text>
          </View>
          {isTaken && (
            <View className="bg-amber-100 px-3 py-1.5 rounded-xl">
              <Text className="text-xs font-black text-amber-700 uppercase tracking-wider">{job.status}</Text>
            </View>
          )}
        </View>

        <ScrollView showsVerticalScrollIndicator={false} contentContainerStyle={{ paddingBottom: 40 }}>
          <View className="mx-5 bg-white rounded-3xl p-5 border border-ink/5 mb-4">
            <Text className="text-xs font-black text-ink/40 uppercase tracking-widest mb-3">
              {job.category === 'CAR' ? '🚗 Car Cleaning' : '🏠 House Cleaning'}
            </Text>

            <View className="gap-3">
              <DetailRow icon={MapPin} title="Location" value={job.location?.address ?? 'Address not provided'} accent={distance ?? undefined} />
              <DetailRow icon={DollarSign} title="Customer Budget" value={budgetLabel} />
              <DetailRow icon={Clock} title="Estimated Duration" value={job.estimatedDuration ? `${job.estimatedDuration} hours` : '2–3 hours'} />
              {job.category === 'HOUSE' && (
                <>
                  {Boolean((job.checklist as HouseChecklist)?.storiesCount || (job.checklist as HouseChecklist)?.roomsCount) && (
                    <DetailRow
                      icon={Home}
                      title="Property Layout"
                      value={[
                        (job.checklist as HouseChecklist).storiesCount ? `${(job.checklist as HouseChecklist).storiesCount} Story` : null,
                        (job.checklist as HouseChecklist).roomsCount ? `${(job.checklist as HouseChecklist).roomsCount} Rooms to clean` : null,
                        (job.checklist as HouseChecklist).bathroomsCount ? `${(job.checklist as HouseChecklist).bathroomsCount} Baths` : null,
                        (job.checklist as HouseChecklist).propertySizeSqm ? `${(job.checklist as HouseChecklist).propertySizeSqm} m²` : null,
                      ].filter(Boolean).join(' · ')}
                      highlight
                    />
                  )}
                </>
              )}
              {job.category === 'CAR' && (job.checklist as CarChecklist)?.registrationNumber && (
                <DetailRow
                  icon={Hash}
                  title="Vehicle Registration"
                  value={(job.checklist as CarChecklist).registrationNumber!}
                  highlight
                />
              )}
              {job.description && <DetailRow icon={MessageSquare} title="Notes" value={job.description} />}
            </View>

            {checklistTags.length > 0 && (
              <View className="flex-row flex-wrap gap-2 mt-4 pt-4 border-t border-ink/5">
                {checklistTags.map((tag) => (
                  <View key={tag} className="bg-accent/10 px-3 py-1.5 rounded-full">
                    <Text className="text-[11px] font-black text-accent">{tag}</Text>
                  </View>
                ))}
              </View>
            )}

            {job.photos?.length > 0 && (
              <View className="mt-4 pt-4 border-t border-ink/5">
                <View className="flex-row items-center justify-between mb-2">
                  <Text className="text-xs font-black text-ink/60 uppercase tracking-wider">
                    📸 Photos of What Needs Cleaning ({job.photos.length})
                  </Text>
                  <Text className="text-[10px] font-bold text-accent">Tap to enlarge</Text>
                </View>
                <ScrollView horizontal showsHorizontalScrollIndicator={false} contentContainerStyle={{ gap: 8 }}>
                  {job.photos.map((url) => (
                    <TouchableOpacity
                      key={url}
                      onPress={() => setSelectedPhotoUrl(url)}
                      activeOpacity={0.8}
                      className="relative rounded-2xl overflow-hidden border border-ink/10"
                    >
                      <Image source={{ uri: url }} style={{ width: 88, height: 88 }} />
                      <View className="absolute bottom-1 left-1 bg-black/75 px-1.5 py-0.5 rounded-md">
                        <Text className="text-[8px] font-black text-white uppercase">Dirty / Before</Text>
                      </View>
                    </TouchableOpacity>
                  ))}
                </ScrollView>
              </View>
            )}

            {job.completionPhotos && job.completionPhotos.length > 0 && (
              <View className="mt-4 pt-4 border-t border-ink/5">
                <View className="flex-row items-center justify-between mb-2">
                  <Text className="text-xs font-black text-emerald-700 uppercase tracking-wider">
                    ✨ Photos When Done ({job.completionPhotos.length})
                  </Text>
                  <Text className="text-[10px] font-bold text-emerald-700">Completed</Text>
                </View>
                <ScrollView horizontal showsHorizontalScrollIndicator={false} contentContainerStyle={{ gap: 8 }}>
                  {job.completionPhotos.map((url) => (
                    <TouchableOpacity
                      key={url}
                      onPress={() => setSelectedPhotoUrl(url)}
                      activeOpacity={0.8}
                      className="relative rounded-2xl overflow-hidden border border-emerald-200"
                    >
                      <Image source={{ uri: url }} style={{ width: 88, height: 88 }} />
                      <View className="absolute bottom-1 left-1 bg-emerald-700/85 px-1.5 py-0.5 rounded-md">
                        <Text className="text-[8px] font-black text-white uppercase">Completed</Text>
                      </View>
                    </TouchableOpacity>
                  ))}
                </ScrollView>
              </View>
            )}
          </View>

          {isTaken ? (
            <View className="mx-5 bg-amber-50 rounded-3xl p-5 border border-amber-100">
              <Text className="text-sm font-black text-amber-700 text-center">This job has already been accepted</Text>
            </View>
          ) : alreadyBid ? (
            <View className="mx-5 bg-emerald-50 rounded-3xl p-5 border border-emerald-100 items-center">
              <Text className="text-2xl mb-2">✅</Text>
              <Text className="text-sm font-black text-emerald-700 text-center">Bid submitted — waiting for customer to accept</Text>
            </View>
          ) : (
            <View className="mx-5 bg-white rounded-3xl p-5 border border-ink/5">
              <Text className="text-xs font-black text-ink/40 uppercase tracking-widest mb-4">Place Your Bid</Text>

              <Text className="text-xs font-black text-ink/50 uppercase tracking-widest mb-1.5">Your Price (USD)</Text>
              <TextInput
                className="border-2 border-ink/10 rounded-2xl px-4 py-3.5 text-xl font-black text-ink bg-ink/[0.02] mb-4"
                placeholder={`${job.budget ?? '0'}.00`}
                placeholderTextColor="#9C94C4"
                keyboardType="decimal-pad"
                value={bidPrice}
                onChangeText={setBidPrice}
              />

              <Text className="text-xs font-black text-ink/50 uppercase tracking-widest mb-1.5">Estimated Arrival (minutes)</Text>
              <TextInput
                className="border-2 border-ink/10 rounded-2xl px-4 py-3.5 text-base font-bold text-ink bg-ink/[0.02] mb-4"
                placeholder="e.g. 20"
                placeholderTextColor="#9C94C4"
                keyboardType="number-pad"
                value={estimatedArrival}
                onChangeText={setEstimatedArrival}
              />

              <View className="flex-row gap-2 mb-4">
                {['10', '20', '30', '45'].map((t) => (
                  <TouchableOpacity
                    key={t}
                    onPress={() => setEstimatedArrival(t)}
                    className={`flex-1 py-2 rounded-xl items-center border ${estimatedArrival === t ? 'bg-accent border-accent' : 'bg-ink/[0.02] border-ink/10'}`}
                  >
                    <Text className={`text-xs font-black ${estimatedArrival === t ? 'text-white' : 'text-ink/60'}`}>{t} min</Text>
                  </TouchableOpacity>
                ))}
              </View>

              <Text className="text-xs font-black text-ink/50 uppercase tracking-widest mb-1.5">Message (optional)</Text>
              <TextInput
                className="border-2 border-ink/10 rounded-2xl px-4 py-3 text-sm font-medium text-ink bg-ink/[0.02] mb-5"
                placeholder="Introduce yourself or mention your experience…"
                placeholderTextColor="#9C94C4"
                multiline
                numberOfLines={3}
                maxLength={200}
                value={message}
                onChangeText={setMessage}
              />

              <TouchableOpacity
                onPress={handleSubmitBid}
                disabled={isSubmitting || !bidPrice || !estimatedArrival}
                activeOpacity={0.85}
                className={`py-5 rounded-[32px] items-center ${bidPrice && estimatedArrival ? 'bg-accent shadow-lg shadow-accent/30' : 'bg-ink/10'}`}
              >
                {isSubmitting ? (
                  <ActivityIndicator color="#fff" />
                ) : (
                  <Text className={`font-black text-sm uppercase tracking-widest ${bidPrice && estimatedArrival ? 'text-white' : 'text-ink/30'}`}>
                    Submit Bid ${bidPrice || '—'}
                  </Text>
                )}
              </TouchableOpacity>
            </View>
          )}
        </ScrollView>
      </KeyboardAvoidingView>

      <Modal
        visible={!!selectedPhotoUrl}
        transparent
        animationType="fade"
        onRequestClose={() => setSelectedPhotoUrl(null)}
      >
        <View className="flex-1 bg-black/90 items-center justify-center p-4">
          <TouchableOpacity
            onPress={() => setSelectedPhotoUrl(null)}
            className="absolute top-12 right-6 w-10 h-10 rounded-full bg-white/20 items-center justify-center z-10"
          >
            <X size={22} color="#fff" />
          </TouchableOpacity>
          {selectedPhotoUrl && (
            <Image
              source={{ uri: selectedPhotoUrl }}
              style={{ width: '100%', height: '80%', resizeMode: 'contain' }}
            />
          )}
        </View>
      </Modal>
    </SafeAreaView>
  );
}

function DetailRow({
  icon: Icon, title, value, accent, highlight,
}: {
  icon: any; title: string; value: string; accent?: string; highlight?: boolean;
}) {
  return (
    <View className={`flex-row items-start gap-3 ${highlight ? 'bg-accent/5 -mx-1 px-1 py-1.5 rounded-2xl' : ''}`}>
      <View className={`w-8 h-8 rounded-xl items-center justify-center mt-0.5 ${highlight ? 'bg-accent' : 'bg-accent/10'}`}>
        <Icon size={14} color={highlight ? '#fff' : '#3906D2'} />
      </View>
      <View className="flex-1">
        <Text className="text-sm font-black text-ink">{title}</Text>
        <Text className={`text-sm font-black mt-0.5 tracking-widest ${highlight ? 'text-accent' : 'text-xs text-ink/50 font-medium'}`}>
          {value}
        </Text>
        {accent && <Text className="text-xs text-accent font-black mt-0.5">{accent}</Text>}
      </View>
    </View>
  );
}

function getChecklistTags(job: Job): string[] {
  const checklist = job.checklist;
  if (!checklist) return [];
  if (checklist.category === 'HOUSE') {
    const c = checklist as HouseChecklist;
    return [...(c.cleaningTypes ?? []), ...(c.areas ?? []).slice(0, 4)];
  }
  const c = checklist as CarChecklist;
  return [...(c.cleaningTypes ?? []), ...(c.exteriorServices ?? []).slice(0, 2), ...(c.interiorServices ?? []).slice(0, 2)];
}
