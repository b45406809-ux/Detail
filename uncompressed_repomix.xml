import React, { useState } from 'react';
import { View, Text, TouchableOpacity, ActivityIndicator, Alert } from 'react-native';
import { router } from 'expo-router';
import { SafeAreaView } from 'react-native-safe-area-context';
import { MapPin, Bell, Shield } from 'lucide-react-native';
import * as Location from 'expo-location';
import * as Notifications from 'expo-notifications';
import { useAuth } from '../../context/AuthContext';
import { getExpoPushToken } from '../../services/notifications';
import { GlassCard } from '../../components/glass';

const PERMISSIONS = [
  {
    id: 'location',
    icon: MapPin,
    title: 'Location Access',
    sub: 'Required to find cleaners near you and track jobs in real-time',
    required: true,
  },
  {
    id: 'notifications',
    icon: Bell,
    title: 'Notifications',
    sub: 'Receive updates about your job status, cleaner arrival, and messages',
    required: false,
  },
];

export default function PermissionsScreen() {
  const { updateProfile } = useAuth();
  const [granted, setGranted] = useState<Record<string, boolean>>({});
  const [isLoading, setIsLoading] = useState(false);

  const requestLocation = async () => {
    const { status } = await Location.requestForegroundPermissionsAsync();
    setGranted((prev) => ({ ...prev, location: status === 'granted' }));
    if (status !== 'granted') {
      Alert.alert('Location Required', 'Detail needs location access to work properly. Enable it in Settings.', [
        { text: 'OK' },
      ]);
    }
  };

  const requestNotifications = async () => {
    const { status } = await Notifications.requestPermissionsAsync();
    setGranted((prev) => ({ ...prev, notifications: status === 'granted' }));
    if (status === 'granted') {
      const token = await getExpoPushToken();
      if (token) await updateProfile({ expoPushToken: token });
    }
  };

  const handlePermissionRequest = async (id: string) => {
    if (id === 'location') await requestLocation();
    else if (id === 'notifications') await requestNotifications();
  };

  const handleContinue = async () => {
    if (!granted.location) {
      Alert.alert('Location Required', 'Please grant location permission to continue.', [{ text: 'OK' }]);
      return;
    }
    setIsLoading(true);
    try {
      await updateProfile({ hasSetupPermissions: true });
      router.replace('/home');
    } catch {
      Alert.alert('Error', 'Failed to save settings. Please try again.');
    } finally {
      setIsLoading(false);
    }
  };

  return (
    <SafeAreaView className="flex-1 bg-white">
      <View className="flex-1 px-6 pt-8 pb-8 justify-between">
        <View>
          <View className="flex-row gap-2 mb-8">
            {[1, 2, 3].map((step) => (
              <View key={step} className="h-1.5 flex-1 rounded-full" style={{ backgroundColor: '#3906D2' }} />
            ))}
          </View>

          <View className="w-16 h-16 bg-accent/10 border border-accent/20 rounded-3xl items-center justify-center mb-6">
            <Shield size={32} color="#3906D2" />
          </View>
          <Text className="text-3xl font-black text-ink tracking-tight mb-2">Allow permissions</Text>
          <Text className="text-base text-ink/50 font-medium mb-8 leading-relaxed">
            Detail needs a few permissions to match you with cleaners and keep you updated.
          </Text>

          <View className="gap-4">
            {PERMISSIONS.map(({ id, icon: Icon, title, sub, required }) => (
              <GlassCard key={id} variant={granted[id] ? 'light' : 'light'} style={{ padding: 20 }}>
                <View className="flex-row items-start gap-4">
                  <View
                    className="w-12 h-12 rounded-2xl items-center justify-center"
                    style={{ backgroundColor: granted[id] ? '#0FB77A' : 'rgba(57,6,210,0.1)' }}
                  >
                    <Icon size={22} color={granted[id] ? '#fff' : '#3906D2'} />
                  </View>
                  <View className="flex-1">
                    <View className="flex-row items-center gap-2 mb-1">
                      <Text className="text-sm font-black text-ink">{title}</Text>
                      {required && (
                        <View className="bg-accent/10 px-2 py-0.5 rounded-full">
                          <Text className="text-[10px] font-black text-accent uppercase tracking-wider">
                            Required
                          </Text>
                        </View>
                      )}
                    </View>
                    <Text className="text-xs text-ink/50 font-medium leading-relaxed">{sub}</Text>
                  </View>
                </View>

                {!granted[id] && (
                  <TouchableOpacity
                    onPress={() => handlePermissionRequest(id)}
                    activeOpacity={0.8}
                    className="mt-4 bg-accent py-3 rounded-2xl items-center"
                  >
                    <Text className="text-white font-black text-xs uppercase tracking-widest">
                      Allow {title}
                    </Text>
                  </TouchableOpacity>
                )}
              </GlassCard>
            ))}
          </View>
        </View>

        <TouchableOpacity
          onPress={handleContinue}
          disabled={isLoading}
          activeOpacity={0.85}
          className="w-full bg-accent py-5 rounded-[28px] items-center mt-6 shadow-lg shadow-accent/30"
        >
          {isLoading ? (
            <ActivityIndicator color="#fff" />
          ) : (
            <Text className="font-black text-sm uppercase tracking-widest text-white">Continue to App</Text>
          )}
        </TouchableOpacity>
      </View>
    </SafeAreaView>
  );
}
</file>

<file path="mobile/app/(auth)/splash.tsx">
import React, { useEffect, useRef, useState } from 'react';
import { View, StyleSheet } from 'react-native';
import { VideoView, useVideoPlayer } from 'expo-video';
import { router } from 'expo-router';

// This is the actual Detail intro video (brand swoosh → D. mark → wordmark),
// played back verbatim rather than re-animated, per the reference asset from
// Drive. Falls through to welcome automatically when it finishes, with a
// safety timeout in case playback stalls on a given device.
const INTRO_SOURCE = require('../../assets/intro.mp4');

export default function SplashScreen() {
  const [didNavigate, setDidNavigate] = useState(false);
  const navigatedRef = useRef(false);

  const player = useVideoPlayer(INTRO_SOURCE, (p) => {
    p.loop = false;
    p.muted = false;
    p.play();
  });

  const goNext = () => {
    if (navigatedRef.current) return;
    navigatedRef.current = true;
    setDidNavigate(true);
    router.replace('/(auth)/welcome');
  };

  useEffect(() => {
    const sub = player.addListener('playToEnd', goNext);
    // Safety net: never strand the user on the splash if the video fails to
    // load or the playToEnd event doesn't fire on a given device/codec.
    const timer = setTimeout(goNext, 8000);
    return () => {
      sub.remove();
      clearTimeout(timer);
    };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [player]);

  return (
    <View style={styles.root}>
      {!didNavigate && (
        <VideoView
          style={StyleSheet.absoluteFill}
          player={player}
          nativeControls={false}
          contentFit="cover"
          allowsFullscreen={false}
          allowsPictureInPicture={false}
        />
      )}
    </View>
  );
}

const styles = StyleSheet.create({
  root: { flex: 1, backgroundColor: '#3906D2' },
});
</file>

