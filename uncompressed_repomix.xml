<file path="mobile/scripts/generate-notification-sounds.js">
const fs = require('fs');
const path = require('path');

const SAMPLE_RATE = 22050;
const DURATION_SECONDS = 0.3;

/** Generate deterministic PCM tones without storing binary patches in Git. */
function generateNotificationSounds() {
  const outputDirectory = path.join(__dirname, '..', 'assets', 'sounds');
  fs.mkdirSync(outputDirectory, { recursive: true });

  for (const [name, frequency] of [['booking', 660], ['urgent', 880]]) {
    const sampleCount = Math.floor(SAMPLE_RATE * DURATION_SECONDS);
    const dataSize = sampleCount * 2;
    const wav = Buffer.alloc(44 + dataSize);
    wav.write('RIFF', 0);
    wav.writeUInt32LE(36 + dataSize, 4);
    wav.write('WAVE', 8);
    wav.write('fmt ', 12);
    wav.writeUInt32LE(16, 16);
    wav.writeUInt16LE(1, 20);
    wav.writeUInt16LE(1, 22);
    wav.writeUInt32LE(SAMPLE_RATE, 24);
    wav.writeUInt32LE(SAMPLE_RATE * 2, 28);
    wav.writeUInt16LE(2, 32);
    wav.writeUInt16LE(16, 34);
    wav.write('data', 36);
    wav.writeUInt32LE(dataSize, 40);

    for (let sample = 0; sample < sampleCount; sample += 1) {
      const progress = sample / sampleCount;
      const envelope = Math.sin(Math.PI * progress) ** 2;
      const value = Math.round(5000 * envelope * Math.sin(2 * Math.PI * frequency * sample / SAMPLE_RATE));
      wav.writeInt16LE(value, 44 + sample * 2);
    }
    fs.writeFileSync(path.join(outputDirectory, `${name}.wav`), wav);
  }
}

if (require.main === module) generateNotificationSounds();
module.exports = { generateNotificationSounds };
</file>

<file path="mobile/types/firebase-rn.d.ts">
// `getReactNativePersistence` lives behind @firebase/auth's "react-native" package.json
// export condition (see node_modules/@firebase/auth/dist/index.rn.d.ts). Metro resolves
// that condition correctly at bundle/runtime, but plain `tsc`'s type resolution for
// "firebase/auth" always points at the generic (non-RN) .d.ts, so it errors as a missing
// export even though the app works fine. This augments the module's types to match what
// actually ships at runtime.
//
// The top-level `export {}` is required — without it this file has no top-level
// import/export and TypeScript treats the `declare module` below as a full replacement
// of "firebase/auth" (dropping every other export) instead of an augmentation.
export {};

import type { Persistence } from '@firebase/auth';

declare module 'firebase/auth' {
  export function getReactNativePersistence(storage: unknown): Persistence;
}
</file>

