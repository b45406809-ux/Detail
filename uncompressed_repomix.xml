      values('paynow_refund_'||j.id,j.id,j.customerId,j.cleanerId,j.customerId,'PAYNOW_REFUND_AFTER_RELEASE','Paynow reported a refund after cleaner earnings were released.','{}'::jsonb) on conflict(id) do nothing;
