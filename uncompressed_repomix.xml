import React, { useEffect, useState } from 'react';
import { View, Text, FlatList, TouchableOpacity, ActivityIndicator } from 'react-native';
import { SafeAreaView } from 'react-native-safe-area-context';
import { router } from 'expo-router';
import { ArrowLeft, Bell, MessageSquare, DollarSign, Star, Zap, Info } from 'lucide-react-native';
import { useAuth } from '../context/AuthContext';
import { db, collection, query, where, onSnapshot, doc, updateDoc, orderBy, limit } from '../services/firebase';
import { AppNotification, NotificationType } from '../types';

const TYPE_ICON: Record<NotificationType, any> = {
  NEW_BID: Zap,
  BID_ACCEPTED: Zap,
  JOB_UPDATE: Info,
  MESSAGE: MessageSquare,
  PAYMENT: DollarSign,
  RATING: Star,
  SYSTEM: Bell,
};

export default function NotificationsScreen() {
  const { user } = useAuth();
  const [items, setItems] = useState<AppNotification[]>([]);
  const [isLoading, setIsLoading] = useState(true);

  useEffect(() => {
    if (!user) return;
    const q = query(collection(db, 'notifications'), where('userId', '==', user.uid), orderBy('createdAt', 'desc'), limit(50));
    return onSnapshot(
      q,
      (snap) => {
        setItems(snap.docs.map((d) => ({ id: d.id, ...d.data() } as AppNotification)));
        setIsLoading(false);
      },
      () => setIsLoading(false)
    );
  }, [user]);

  const openNotification = (n: AppNotification) => {
    if (!n.read) updateDoc(doc(db, 'notifications', n.id), { read: true }).catch(() => {});
    if (n.jobId) router.push({ pathname: '/tracking/[jobId]', params: { jobId: n.jobId } });
  };

  return (
    <SafeAreaView className="flex-1 bg-[#F3F1FC]">
      <View className="flex-row items-center gap-3 px-5 pt-4 pb-4">
        <TouchableOpacity onPress={() => router.back()} className="w-10 h-10 bg-white rounded-2xl items-center justify-center border border-ink/5">
          <ArrowLeft size={18} color="#150256" />
        </TouchableOpacity>
        <Text className="text-xl font-black text-ink">Notifications</Text>
      </View>

      {isLoading ? (
        <View className="flex-1 items-center justify-center">
          <ActivityIndicator color="#3906D2" size="large" />
        </View>
      ) : items.length === 0 ? (
        <View className="flex-1 items-center justify-center px-6">
          <View className="w-20 h-20 bg-accent/10 rounded-3xl items-center justify-center mb-4">
            <Bell size={32} color="#3906D2" />
          </View>
          <Text className="text-lg font-black text-ink text-center">You're all caught up</Text>
          <Text className="text-sm text-ink/40 font-medium text-center mt-2">
            Job updates, new quotes, and messages will show up here
          </Text>
        </View>
      ) : (
        <FlatList
          data={items}
          keyExtractor={(n) => n.id}
          contentContainerClassName="px-5 pb-10 gap-3"
          showsVerticalScrollIndicator={false}
          renderItem={({ item }) => {
            const Icon = TYPE_ICON[item.type] ?? Bell;
            return (
              <TouchableOpacity
                onPress={() => openNotification(item)}
                activeOpacity={0.85}
                className={`bg-white rounded-3xl p-4 flex-row items-start gap-3 border ${item.read ? 'border-ink/5' : 'border-accent/30'}`}
              >
                <View className={`w-10 h-10 rounded-2xl items-center justify-center ${item.read ? 'bg-ink/5' : 'bg-accent/10'}`}>
                  <Icon size={18} color={item.read ? '#9C94C4' : '#3906D2'} />
                </View>
                <View className="flex-1">
                  <Text className={`text-sm ${item.read ? 'font-bold text-ink/70' : 'font-black text-ink'}`}>{item.title}</Text>
                  <Text className="text-xs text-ink/40 font-medium mt-0.5">{item.body}</Text>
                </View>
                {!item.read && <View className="w-2 h-2 rounded-full bg-accent mt-1.5" />}
              </TouchableOpacity>
            );
          }}
        />
      )}
    </SafeAreaView>
  );
}
</file>

<file path="mobile/app/register-cleaner.tsx">
// Cleaner registration — collects the identity/verification info required by
// the Cleaner Agreement §4 (full name, phone, physical address, proof of
// residence) plus service details, and proves email ownership via Firebase's
// built-in email-verification flow (the OTP-equivalent — no separate email
// provider needed). Reached from profile.tsx's "Switch to Cleaner" action
// whenever cleanerOnboardingComplete or hasAgreedToTerms is missing; ends by
// routing into cleaner-agreement.tsx, which is what actually flips role.
import React, { useState } from 'react';
import {
  View,
  Text,
  TextInput,
  TouchableOpacity,
  ScrollView,
  KeyboardAvoidingView,
  Platform,
  ActivityIndicator,
  Alert,
  Image,
} from 'react-native';
import { SafeAreaView } from 'react-native-safe-area-context';
import { router } from 'expo-router';
import * as ImagePicker from 'expo-image-picker';
import {
  ArrowLeft,
  User,
  MapPin,
  Home as HomeIcon,
  Car,
  Camera,
  Mail,
  CheckCircle2,
} from 'lucide-react-native';
import { useAuth } from '../context/AuthContext';
import { auth, sendEmailVerification } from '../services/firebase';
import { uploadProofOfResidence } from '../services/storage';
import { ServiceCategory } from '../types';

const CATEGORY_OPTIONS: { id: ServiceCategory; label: string; icon: any }[] = [
  { id: 'HOUSE', label: 'House Cleaning', icon: HomeIcon },
  { id: 'CAR', label: 'Car Cleaning', icon: Car },
];

export default function RegisterCleanerScreen() {
  const { profile, updateProfile } = useAuth();
  const [fullName, setFullName] = useState(profile?.displayName ?? '');
  const [phone, setPhone] = useState(profile?.phone ?? '');
  const [address, setAddress] = useState('');
  const [categories, setCategories] = useState<ServiceCategory[]>([]);
  const [radius, setRadius] = useState('15');
  const [experience, setExperience] = useState('');
  const [proofUri, setProofUri] = useState<string | null>(null);
  const [isUploading, setIsUploading] = useState(false);
  const [isSubmitting, setIsSubmitting] = useState(false);

  const emailVerified = auth.currentUser?.emailVerified ?? false;
  const [verificationSent, setVerificationSent] = useState(false);

  const toggleCategory = (id: ServiceCategory) =>
    setCategories((prev) => (prev.includes(id) ? prev.filter((c) => c !== id) : [...prev, id]));

  const handleSendVerification = async () => {
    if (!auth.currentUser) return;
    try {
      await sendEmailVerification(auth.currentUser);
      setVerificationSent(true);
      Alert.alert('Check your email', 'We sent a verification link to confirm this is your email.');
    } catch {
      Alert.alert('Error', 'Could not send the verification email. Please try again.');
    }
  };

  const handleCheckVerification = async () => {
    try {
      await auth.currentUser?.reload();
      if (!auth.currentUser?.emailVerified) {
        Alert.alert('Not verified yet', 'Open the link in the email we sent, then try again.');
      }
    } catch {
      Alert.alert('Error', 'Could not check verification status.');
    }
  };

  const pickProof = async () => {
    const result = await ImagePicker.launchImageLibraryAsync({
      mediaTypes: ImagePicker.MediaTypeOptions.Images,
      quality: 0.8,
    });
    if (!result.canceled && result.assets[0]) setProofUri(result.assets[0].uri);
  };

  const handleSubmit = async () => {
    if (!fullName.trim() || !phone.trim() || !address.trim()) {
      Alert.alert('Missing info', 'Please fill in your full name, phone, and physical address.');
      return;
    }
    if (categories.length === 0) {
      Alert.alert('Pick a service', 'Choose at least one service you want to offer.');
      return;
    }
    if (!proofUri) {
      Alert.alert('Proof of residence required', 'Upload a photo showing your physical address.');
      return;
    }
    if (!emailVerified) {
      Alert.alert('Verify your email', 'Please verify your email before continuing.');
      return;
    }

    setIsSubmitting(true);
    try {
      setIsUploading(true);
      const proofOfResidenceUrl = await uploadProofOfResidence(proofUri);
      setIsUploading(false);

      await updateProfile({
        displayName: fullName.trim(),
        phone: phone.trim(),
        address: address.trim(),
        serviceCategories: categories,
        serviceRadiusKm: Number(radius) || 15,
        experienceYears: Number(experience) || 0,
        proofOfResidenceUrl,
        verificationStatus: 'PENDING',
        cleanerOnboardingComplete: true,
      });
      router.push('/cleaner-agreement');
    } catch {
      Alert.alert('Error', 'Failed to submit your registration. Please try again.');
    } finally {
      setIsSubmitting(false);
      setIsUploading(false);
    }
  };

  return (
    <SafeAreaView className="flex-1 bg-white">
      <View className="flex-row items-center gap-3 px-5 pt-4 pb-4 border-b border-slate-100">
        <TouchableOpacity
          onPress={() => router.back()}
          className="w-10 h-10 bg-slate-50 rounded-2xl items-center justify-center"
        >
          <ArrowLeft size={18} color="#0f172a" />
        </TouchableOpacity>
        <View>
          <Text className="text-xl font-black text-slate-900">Become a Cleaner</Text>
          <Text className="text-xs text-slate-400 font-medium">Register to start accepting jobs</Text>
        </View>
      </View>

      <KeyboardAvoidingView className="flex-1" behavior={Platform.OS === 'ios' ? 'padding' : 'height'}>
        <ScrollView contentContainerClassName="px-5 pt-6 pb-10" keyboardShouldPersistTaps="handled">
          {/* Identity */}
          <Text className="text-xs font-black text-slate-400 uppercase tracking-widest mb-3">
            Your Details
          </Text>
          <View className="gap-3 mb-6">
            <LabeledInput icon={User} label="Full Name" value={fullName} onChangeText={setFullName} placeholder="Your full legal name" />
            <LabeledInput icon={User} label="Phone Number" value={phone} onChangeText={setPhone} placeholder="+263 7X XXX XXXX" keyboardType="phone-pad" />
            <LabeledInput icon={MapPin} label="Physical Address" value={address} onChangeText={setAddress} placeholder="Street, suburb, city" multiline />
          </View>

          {/* Email verification */}
          <Text className="text-xs font-black text-slate-400 uppercase tracking-widest mb-3">
            Email Verification
          </Text>
          <View className="bg-slate-50 rounded-3xl p-4 border border-slate-100 mb-6 flex-row items-center gap-3">
            <View className={`w-10 h-10 rounded-2xl items-center justify-center ${emailVerified ? 'bg-emerald-100' : 'bg-accent/10'}`}>
              {emailVerified ? <CheckCircle2 size={18} color="#10b981" /> : <Mail size={18} color="#3906D2" />}
            </View>
            <View className="flex-1">
              <Text className="text-sm font-black text-slate-900">
                {emailVerified ? 'Email verified' : 'Verify your email'}
              </Text>
              <Text className="text-xs text-slate-400 font-medium mt-0.5">
                {emailVerified ? "You're all set" : 'Confirms this is really your email address'}
              </Text>
            </View>
            {!emailVerified && (
              <TouchableOpacity
                onPress={verificationSent ? handleCheckVerification : handleSendVerification}
                className="bg-accent px-3 py-2 rounded-xl"
              >
                <Text className="text-white text-xs font-black">{verificationSent ? 'Check' : 'Send'}</Text>
              </TouchableOpacity>
            )}
          </View>

          {/* Service details */}
          <Text className="text-xs font-black text-slate-400 uppercase tracking-widest mb-3">
            Services You Offer
          </Text>
          <View className="flex-row gap-3 mb-4">
            {CATEGORY_OPTIONS.map(({ id, label, icon: Icon }) => {
              const selected = categories.includes(id);
              return (
                <TouchableOpacity
                  key={id}
                  onPress={() => toggleCategory(id)}
                  activeOpacity={0.85}
                  className={`flex-1 items-center gap-2 py-4 rounded-2xl border ${
                    selected ? 'bg-accent/10 border-accent' : 'bg-slate-50 border-slate-100'
                  }`}
                >
                  <Icon size={22} color={selected ? '#3906D2' : '#64748b'} />
                  <Text className={`text-xs font-black ${selected ? 'text-accent' : 'text-slate-500'}`}>{label}</Text>
                </TouchableOpacity>
              );
            })}
          </View>
          <View className="flex-row gap-3 mb-6">
            <View className="flex-1">
              <LabeledInput label="Service Radius (km)" value={radius} onChangeText={setRadius} keyboardType="number-pad" />
            </View>
            <View className="flex-1">
              <LabeledInput label="Years of Experience" value={experience} onChangeText={setExperience} keyboardType="number-pad" />
            </View>
          </View>

          {/* Proof of residence */}
          <Text className="text-xs font-black text-slate-400 uppercase tracking-widest mb-3">
            Proof of Residence
          </Text>
          <TouchableOpacity
            onPress={pickProof}
            activeOpacity={0.85}
            className="bg-slate-50 rounded-3xl border border-dashed border-slate-200 items-center justify-center mb-6"
            style={{ height: 140 }}
          >
            {proofUri ? (
              <Image source={{ uri: proofUri }} style={{ width: '100%', height: '100%', borderRadius: 24 }} resizeMode="cover" />
            ) : (
              <>
                <Camera size={24} color="#94a3b8" />
                <Text className="text-xs font-bold text-slate-400 mt-2">
                  Utility bill, lease, or ID with your address
                </Text>
              </>
            )}
          </TouchableOpacity>
          <Text className="text-[11px] text-slate-400 font-medium mb-8 leading-relaxed">
            Detail staff review this manually to confirm your address before your account is fully
            verified — you can start browsing jobs once you accept the Cleaner Agreement, but higher-value
            jobs require verification to be complete.
          </Text>

          <TouchableOpacity
            onPress={handleSubmit}
            disabled={isSubmitting}
            activeOpacity={0.85}
            className="bg-accent py-5 rounded-[32px] items-center shadow-lg shadow-accent/30"
          >
            {isSubmitting ? (
              <View className="flex-row items-center gap-2">
                <ActivityIndicator color="#fff" />
                {isUploading && (
                  <Text className="text-white font-black text-xs uppercase tracking-widest">Uploading…</Text>
                )}
              </View>
            ) : (
              <Text className="text-white font-black text-sm uppercase tracking-widest">
                Continue to Agreement
              </Text>
            )}
          </TouchableOpacity>
        </ScrollView>
      </KeyboardAvoidingView>
    </SafeAreaView>
  );
}

function LabeledInput({
  icon: Icon,
  label,
  value,
  onChangeText,
  placeholder,
  keyboardType,
  multiline,
}: {
  icon?: any;
  label: string;
  value: string;
  onChangeText: (v: string) => void;
  placeholder?: string;
  keyboardType?: 'default' | 'phone-pad' | 'number-pad';
  multiline?: boolean;
}) {
  return (
    <View>
      <Text className="text-xs font-black text-slate-500 uppercase tracking-widest mb-1.5">{label}</Text>
      <View className="flex-row items-center border-2 border-slate-100 rounded-2xl px-4 bg-slate-50">
        {Icon && <Icon size={16} color="#94a3b8" style={{ marginRight: 8 }} />}
        <TextInput
          className="flex-1 py-3.5 text-sm font-bold text-slate-900"
          placeholder={placeholder}
          placeholderTextColor="#94a3b8"
          value={value}
          onChangeText={onChangeText}
          keyboardType={keyboardType}
          multiline={multiline}
        />
      </View>
    </View>
  );
}
</file>

<file path="mobile/app/reviews.tsx">
import React, { useEffect, useState } from 'react';
import {
  View,
  Text,
  FlatList,
  TouchableOpacity,
  ActivityIndicator,
} from 'react-native';
import { SafeAreaView } from 'react-native-safe-area-context';
import { router } from 'expo-router';
import { ArrowLeft, Star } from 'lucide-react-native';
import { useAuth } from '../context/AuthContext';
import {
  db,
  collection,
  query,
  where,
  onSnapshot,
  orderBy,
  limit,
} from '../services/firebase';

interface Review {
  id: string;
  customerId: string;
  customerName: string;
  jobId: string;
  rating: number;
  comment: string;
  createdAt: any;
}

export default function ReviewsScreen() {
  const { user, profile } = useAuth();
  const [reviews, setReviews] = useState<Review[]>([]);
  const [isLoading, setIsLoading] = useState(true);

  useEffect(() => {
    if (!user) return;
    const q = query(
      collection(db, 'reviews'),
      where('cleanerId', '==', user.uid),
      orderBy('createdAt', 'desc'),
      limit(50)
    );
    const unsub = onSnapshot(q, (snap) => {
      setReviews(snap.docs.map((d) => ({ id: d.id, ...d.data() } as Review)));
      setIsLoading(false);
    });
    return unsub;
  }, [user]);

  const averageRating =
    reviews.length > 0
      ? reviews.reduce((sum, r) => sum + r.rating, 0) / reviews.length
      : null;

  return (
    <SafeAreaView className="flex-1 bg-[#F2F1F5]">
      {/* Header */}
      <View className="flex-row items-center gap-3 px-5 pt-4 pb-4">
        <TouchableOpacity
          onPress={() => router.back()}
          className="w-10 h-10 bg-white rounded-2xl items-center justify-center border border-slate-100"
        >
          <ArrowLeft size={18} color="#0f172a" />
        </TouchableOpacity>
        <View className="flex-1">
          <Text className="text-xl font-black text-slate-900">My Reviews</Text>
          <Text className="text-xs text-slate-400 font-medium">
            Ratings left by customers
          </Text>
        </View>
      </View>

      {/* Summary card */}
      {averageRating !== null && (
        <View className="mx-5 mb-5 bg-white rounded-3xl p-5 flex-row items-center gap-5 border border-slate-100">
          <View className="items-center">
            <Text className="text-4xl font-black text-slate-900">
              {averageRating.toFixed(1)}
            </Text>
            <View className="flex-row mt-1">
              {[1, 2, 3, 4, 5].map((s) => (
                <Star
                  key={s}
                  size={14}
                  color="#f59e0b"
                  fill={s <= Math.round(averageRating) ? '#f59e0b' : 'transparent'}
                />
              ))}
            </View>
          </View>
          <View className="w-px h-12 bg-slate-100" />
          <View>
            <Text className="text-2xl font-black text-slate-900">{reviews.length}</Text>
            <Text className="text-xs text-slate-400 font-medium uppercase tracking-wider">
              Total reviews
            </Text>
          </View>
          <View className="w-px h-12 bg-slate-100" />
          <View>
            <Text className="text-2xl font-black text-slate-900">
              {profile?.jobsCompleted ?? 0}
            </Text>
            <Text className="text-xs text-slate-400 font-medium uppercase tracking-wider">
              Jobs done
            </Text>
          </View>
        </View>
      )}

      {isLoading ? (
        <View className="flex-1 items-center justify-center">
          <ActivityIndicator color="#3906d2" size="large" />
        </View>
      ) : reviews.length === 0 ? (
        <View className="flex-1 items-center justify-center px-8">
          <Text className="text-4xl mb-4">⭐</Text>
          <Text className="text-lg font-black text-slate-900 text-center">
            No reviews yet
          </Text>
          <Text className="text-sm text-slate-400 font-medium text-center mt-2">
            Complete jobs to receive ratings from customers
          </Text>
        </View>
      ) : (
        <FlatList
          data={reviews}
          keyExtractor={(r) => r.id}
          contentContainerStyle={{ paddingHorizontal: 20, paddingBottom: 32, gap: 12 }}
          showsVerticalScrollIndicator={false}
          renderItem={({ item }) => (
            <View className="bg-white rounded-3xl p-5 border border-slate-100">
              <View className="flex-row items-start justify-between mb-3">
                <View>
                  <Text className="text-sm font-black text-slate-900">
                    {item.customerName || 'Customer'}
                  </Text>
                  <Text className="text-xs text-slate-400 font-medium mt-0.5">
                    {item.createdAt?.toDate?.()?.toLocaleDateString() ?? 'Recent'}
                  </Text>
                </View>
                {/* Star rating */}
                <View className="flex-row gap-0.5">
                  {[1, 2, 3, 4, 5].map((s) => (
                    <Star
                      key={s}
                      size={14}
                      color="#f59e0b"
                      fill={s <= item.rating ? '#f59e0b' : 'transparent'}
                    />
                  ))}
                </View>
              </View>
              {item.comment ? (
                <Text className="text-sm text-slate-600 font-medium leading-relaxed italic">
                  "{item.comment}"
                </Text>
              ) : (
                <Text className="text-sm text-slate-300 font-medium italic">No comment left</Text>
              )}
            </View>
          )}
        />
      )}
    </SafeAreaView>
  );
}
</file>

