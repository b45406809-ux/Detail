name: Deploy Firebase backend

on:
  push:
    branches: [main]
    paths:
      - functions/**
      - firestore.rules
      - firestore.indexes.json
      - storage.rules
      - firebase.json
      - .firebaserc
      - .github/workflows/deploy-firebase.yml
  workflow_dispatch:
    inputs:
      bootstrap_admin:
        description: Create/update the initial elevated admin using INITIAL_ADMIN_PASSWORD
        required: false
        default: false
        type: boolean

concurrency:
  group: production-firebase
  cancel-in-progress: false

permissions:
  contents: read

jobs:
  deploy:
    runs-on: ubuntu-latest
    environment: production
    env:
      FIREBASE_PROJECT_ID: ${{ vars.FIREBASE_PROJECT_ID || 'new1-4bb94' }}
      FIREBASE_CLIENT_EMAIL: ${{ vars.FIREBASE_CLIENT_EMAIL || 'firebase-adminsdk-fbsvc@new1-4bb94.iam.gserviceaccount.com' }}
      FIREBASE_CLIENT_ID: ${{ vars.FIREBASE_CLIENT_ID || '116940176729062539328' }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Create ephemeral Google credentials file
        env:
          FIREBASE_PRIVATE_KEY_ID: ${{ vars.FIREBASE_PRIVATE_KEY_ID }}
          FIREBASE_PRIVATE_KEY: ${{ secrets.FIREBASE_PRIVATE_KEY }}
        run: |
          python3 - <<'PY'
          import json, os
          required=['FIREBASE_PROJECT_ID','FIREBASE_PRIVATE_KEY_ID','FIREBASE_PRIVATE_KEY','FIREBASE_CLIENT_EMAIL','FIREBASE_CLIENT_ID']
          missing=[name for name in required if not os.environ.get(name)]
          if missing: raise SystemExit('Missing GitHub production configuration: '+', '.join(missing))
          credentials={
            'type':'service_account','project_id':os.environ['FIREBASE_PROJECT_ID'],
            'private_key_id':os.environ['FIREBASE_PRIVATE_KEY_ID'],
            'private_key':os.environ['FIREBASE_PRIVATE_KEY'].replace('\\n','\n'),
            'client_email':os.environ['FIREBASE_CLIENT_EMAIL'],'client_id':os.environ['FIREBASE_CLIENT_ID'],
            'auth_uri':'https://accounts.google.com/o/oauth2/auth','token_uri':'https://oauth2.googleapis.com/token',
            'auth_provider_x509_cert_url':'https://www.googleapis.com/oauth2/v1/certs',
            'client_x509_cert_url':'https://www.googleapis.com/robot/v1/metadata/x509/'+os.environ['FIREBASE_CLIENT_EMAIL'].replace('@','%40'),
            'universe_domain':'googleapis.com'
          }
          path=os.path.join(os.environ['RUNNER_TEMP'],'firebase-service-account.json')
          with open(path,'w') as handle: json.dump(credentials,handle)
          with open(os.environ['GITHUB_ENV'],'a') as handle: handle.write('GOOGLE_APPLICATION_CREDENTIALS='+path+'\n')
          PY
          chmod 600 "$RUNNER_TEMP/firebase-service-account.json"

      - name: Install and build Functions
        run: npm ci --prefix functions && npm run build --prefix functions

      - name: Deploy Functions, rules, indexes, and storage rules
        run: npx --yes firebase-tools@latest deploy --project "$FIREBASE_PROJECT_ID" --only functions,firestore:rules,firestore:indexes,storage

      - name: Bootstrap initial elevated admin
        if: ${{ github.event_name == 'workflow_dispatch' && inputs.bootstrap_admin }}
        env:
          ADMIN_EMAIL: ${{ vars.INITIAL_ADMIN_EMAIL || 'crzzphillip@gmail.com' }}
          ADMIN_PASSWORD: ${{ secrets.INITIAL_ADMIN_PASSWORD }}
        run: npm run bootstrap-admin --prefix functions

      - name: Remove credentials file
        if: always()
        run: rm -f "$RUNNER_TEMP/firebase-service-account.json"
</file>

<file path=".github/workflows/deploy.yml">
name: Build and deploy site and dashboard

on:
  push:
    branches: [main]
  workflow_dispatch:

concurrency:
  group: production-cpanel
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  deploy:
    runs-on: ubuntu-latest
    environment: production
    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Create D1 waitlist database and deploy API Worker
        id: waitlist
        env:
          CLOUDFLARE_ACCOUNT_ID: ${{ vars.CLOUDFLARE_ACCOUNT_ID }}
          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          TURNSTILE_SECRET: ${{ secrets.TURNSTILE_SECRET }}
          RESEND_API_KEY: ${{ secrets.RESEND_API_KEY }}
          INITIAL_ADMIN_EMAIL: ${{ vars.INITIAL_ADMIN_EMAIL || 'crzzphillip@gmail.com' }}
          INITIAL_ADMIN_PASSWORD: ${{ secrets.INITIAL_ADMIN_PASSWORD }}
          WAITLIST_ALLOWED_ORIGINS: https://detail.co.zw,https://www.detail.co.zw,https://dashboard.detail.co.zw
        run: python3 scripts/deploy-cloudflare-waitlist.py

      - name: Verify Cloudflare API before building either site
        env:
          WAITLIST_API_URL: ${{ steps.waitlist.outputs.api_url }}
        run: |
          test -n "$WAITLIST_API_URL"
          curl --fail --silent --show-error --retry 5 --retry-all-errors \
            --retry-delay 3 "$WAITLIST_API_URL/health" | grep -q '"storage":"cloudflare-d1"'
          curl --fail --silent --show-error --request OPTIONS \
            --header 'Origin: https://detail.co.zw' \
            --header 'Access-Control-Request-Method: POST' \
            --dump-header /tmp/waitlist-cors.txt --output /dev/null \
            "$WAITLIST_API_URL/api/waitlist"
          grep -qi '^access-control-allow-origin: https://detail.co.zw' /tmp/waitlist-cors.txt

      - name: Install site dependencies
        run: npm ci --prefix site --no-audit --no-fund

      - name: Type-check and build production SPA
        run: npm run build
        env:
          VITE_POSTHOG_KEY: ${{ secrets.VITE_POSTHOG_KEY }}
          VITE_POSTHOG_HOST: ${{ vars.VITE_POSTHOG_HOST }}
          VITE_TURNSTILE_SITE_KEY: ${{ secrets.VITE_TURNSTILE_SITE_KEY }}
          VITE_WAITLIST_API_URL: ${{ steps.waitlist.outputs.api_url }}

      - name: Verify Apache routing file is in the artifact
        run: test -f site/dist/.htaccess

      - name: Deploy main site over explicit FTPS
        uses: SamKirkland/FTP-Deploy-Action@v4.3.5
        with:
          server: ${{ secrets.FTP_SERVER }}
          username: ${{ secrets.FTP_USERNAME }}
          password: ${{ secrets.FTP_PASSWORD }}
          protocol: ftps
          port: 21
          local-dir: site/dist/
          server-dir: public_html/
          exclude: |
            **/.git*
            **/.git*/**

      - name: Deploy dashboard subdomain artifact over explicit FTPS
        uses: SamKirkland/FTP-Deploy-Action@v4.3.5
        with:
          server: ${{ secrets.FTP_SERVER }}
          username: ${{ secrets.FTP_USERNAME }}
          password: ${{ secrets.FTP_PASSWORD }}
          protocol: ftps
          port: 21
          local-dir: site/dist/
          server-dir: public_html/dashboard/
          exclude: |
            **/.git*
            **/.git*/**
</file>

