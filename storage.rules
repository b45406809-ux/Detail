rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuth() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function underSizeLimit() {
      return request.resource.size < 10 * 1024 * 1024; // 10 MB
    }

    function isJobParticipant(jobId) {
      let job = firestore.get(/databases/(default)/documents/jobs/$(jobId)).data;
      return isAuth() && (job.customerId == request.auth.uid || job.cleanerId == request.auth.uid);
    }

    function isApprovedCleaner() {
      let user = firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
      return isAuth() && user.role == 'CLEANER' && user.verificationStatus == 'VERIFIED'
        && user.cleanerAgreementAccepted == true && user.isSuspended != true && user.isBanned != true;
    }

    // Booking photos are private to their uploader and the assigned job parties.
    match /job-photos/{uid}/{allPaths=**} {
      allow read: if isAuth() && (request.auth.uid == uid || isApprovedCleaner());
      allow write: if isAuth() && request.auth.uid == uid && isImage() && underSizeLimit();
    }

    // Chat attachments are accessible only to the booking parties.
    match /chat-photos/{jobId}/{allPaths=**} {
      allow read: if isJobParticipant(jobId);
      allow write: if isJobParticipant(jobId) && isImage() && underSizeLimit();
    }

    match /job-completion/{jobId}/{cleanerId}/{allPaths=**} {
      allow read: if isJobParticipant(jobId);
      allow write: if isAuth() && request.auth.uid == cleanerId && isJobParticipant(jobId)
        && firestore.get(/databases/(default)/documents/jobs/$(jobId)).data.cleanerId == request.auth.uid
        && firestore.get(/databases/(default)/documents/jobs/$(jobId)).data.status in ['ASSIGNED','EN_ROUTE','IN_PROGRESS']
        && isImage() && underSizeLimit();
    }

    // Profile photos.
    match /profile-photos/{uid}/{allPaths=**} {
      allow read: if isAuth();
      allow write: if isAuth() && request.auth.uid == uid && isImage() && underSizeLimit();
    }

    // Proof-of-residence photos captured during cleaner registration
    // (register-cleaner.tsx). Sensitive PII — unlike profile-photos, only
    // the owner can ever read their own upload back; Detail staff review it
    // via the Admin SDK (bypasses rules), not through this path.
    match /verification/{uid}/{allPaths=**} {
      allow read: if isAuth() && request.auth.uid == uid;
      allow write: if isAuth() && request.auth.uid == uid && isImage() && underSizeLimit();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
