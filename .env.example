# Public Supabase project values (safe for client bundles).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Mobile maps: public runtime token plus a private EAS build-only token.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your-public-token
# MAPBOX_DOWNLOADS_TOKEN is an EAS secret with DOWNLOADS:READ scope. Never ship it in the app.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_TURNSTILE_SITE_KEY=

# Server-side secrets must be set with `supabase secrets set` or your CI secret
# store. Never put service role keys or provider secrets in an app .env file.
# SUPABASE_SERVICE_ROLE_KEY
# PAYNOW_INTEGRATION_ID
# PAYNOW_INTEGRATION_KEY
# PAYNOW_RETURN_URL
# DIDIT_API_KEY
# DIDIT_WORKFLOW_ID
# TURNSTILE_SECRET
# RESEND_API_KEY
# PAYOUT_ENCRYPTION_KEY=base64-encoded-32-byte-key (generate with: openssl rand -base64 32)
# CRON_SECRET=long-random-secret-for-the-notification-worker
# TWILIO_ACCOUNT_SID
# TWILIO_AUTH_TOKEN
# TWILIO_MESSAGING_SERVICE_SID
# TWILIO_FROM_NUMBER=+1... (use only when no Messaging Service SID is configured)
# APP_RETURN_URL=detail://payment-return

# Migration operator credentials (local shell only; do not commit values).
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/firebase-service-account.json
# FIREBASE_PROJECT_ID=your-legacy-project
# FIREBASE_STORAGE_BUCKET=your-legacy-project.appspot.com
