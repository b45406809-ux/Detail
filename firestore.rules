rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // Users can read any profile (needed for cleaner name/rating on bid cards).
    // Self can fully update own profile. Other authenticated users may ONLY adjust
    // wallet/aggregate fields — payment settlement and rating aggregation run
    // client-side via runTransaction and must touch the counterparty's doc.
    // Identity fields (email, role, displayName, etc.) stay self-only.
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isOwner(userId);
      allow delete: if false;
      allow update: if isOwner(userId) || (
        isAuth() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['balance', 'jobsCompleted', 'ratingAverage', 'ratingCount', 'updatedAt'])
      );
    }

    // Wallet transactions: users read only their own. Records are immutable.
    // Create is allowed for any authenticated user because payment settlement
    // (runTransaction) writes a CREDIT record for the counterparty (the cleaner).
    match /transactions/{txId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth();
      allow update, delete: if false; // immutable ledger; status updates via Cloud Functions
    }

    // Jobs: customer creates, both parties read their own jobs
    match /jobs/{jobId} {
      // Customer who owns the job or assigned cleaner can read
      allow read: if isAuth() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.cleanerId == request.auth.uid ||
        // Jobs in BIDDING status are visible to all cleaners so they can bid
        resource.data.status == 'BIDDING'
      );
      // Only the job's customer can create a job
      allow create: if isAuth() && request.resource.data.customerId == request.auth.uid;
      // Customer or assigned cleaner can update (status changes, location, etc.)
      allow update: if isAuth() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.cleanerId == request.auth.uid
      );
      allow delete: if false;
    }

    // Bids: cleaners create, customers read bids on their own jobs
    match /bids/{bidId} {
      // Customers can read bids on their own jobs; cleaners can read their own bids
      allow read: if isAuth();
      // Only cleaners can create bids (on BIDDING jobs)
      allow create: if isAuth() && request.resource.data.cleanerId == request.auth.uid;
      // Only the job customer can update bid status (accept/reject)
      // Enforced via runTransaction in client; add server-side check here
      allow update: if isAuth();
      allow delete: if false;
    }

    // Messages: any authenticated user can read; sender must own the message on create.
    match /messages/{msgId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if false;
    }

    // Reviews: only the customer who authored the review can create it
    match /reviews/{reviewId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.customerId == request.auth.uid;
      allow update, delete: if false;
    }

    match /agreement_logs/{logId} {
      allow read, write: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
    }

    match /invoices/{invoiceId} {
      allow read: if isAuth() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.cleanerId == request.auth.uid
      );
      allow write: if false; // Cloud Functions only
    }

    // Deny everything else
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
