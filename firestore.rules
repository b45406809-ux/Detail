rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuth() && request.auth.token.admin == true;
    }

    function isJobParticipant(jobId) {
      let job = get(/databases/$(database)/documents/jobs/$(jobId)).data;
      return isAuth() && (job.customerId == request.auth.uid || job.cleanerId == request.auth.uid);
    }

    function cleanerIsApproved() {
      let cleaner = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isAuth() && cleaner.role == 'CLEANER' && cleaner.verificationStatus == 'VERIFIED'
        && cleaner.cleanerAgreementAccepted == true && cleaner.isSuspended != true && cleaner.isBanned != true;
    }

    function hasPermission(permission) {
      return isAdmin() && permission in request.auth.token.permissions;
    }

    // Keys that change when an update touches any of the listed fields.
    function changed(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ───────────────────────── users ─────────────────────────
    // User documents contain private contact, location, identity and wallet data.
    // Cleaner discovery uses searchVerifiedCleaners, which returns a public projection.
    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['uid','email','displayName','photoURL','role','balance','status','hasCompletedProfile','hasSetupPermissions','hasAgreedToTerms','createdAt'])
        && request.resource.data.role == 'CUSTOMER'
        && request.resource.data.balance is number && request.resource.data.balance == 0;

      allow update: if (
        isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','photoURL','phone','address','hasSetupPermissions','hasCompletedProfile','hasAgreedToTerms','expoPushToken','updatedAt'])
        && (!changed(['hasCompletedProfile']) || request.resource.data.hasCompletedProfile == true)
        && (!changed(['hasAgreedToTerms']) || request.resource.data.hasAgreedToTerms == true)
      );

      allow delete: if false;
    }

    // ───────────────────────── transactions ─────────────────────────
    // Immutable ledger. All writes happen server-side.
    match /transactions/{txId} {
      allow read: if isAdmin() || (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if false;
      allow update, delete: if false;
    }

    // ───────────────────────── jobs / bids ─────────────────────────
    // All booking state, assignment, bid, and payment writes are callable-only.
    match /jobs/{jobId} {
      allow read: if isAdmin() || (isAuth() && (resource.data.customerId == request.auth.uid || resource.data.cleanerId == request.auth.uid));
      allow update: if isJobParticipant(jobId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','lastMessageAt','customerUnread','cleanerUnread'])
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.cleanerId == resource.data.cleanerId
        && request.resource.data.status == resource.data.status
        && request.resource.data.customerUnread is int && request.resource.data.customerUnread >= 0
        && request.resource.data.cleanerUnread is int && request.resource.data.cleanerUnread >= 0
        && ((request.auth.uid == resource.data.customerId
          && request.resource.data.customerUnread == 0
          && request.resource.data.cleanerUnread == resource.data.cleanerUnread + 1
          && request.resource.data.lastMessage is string
          && request.resource.data.lastMessage.size() <= 2000
          && request.resource.data.lastMessageAt is timestamp)
          || (request.auth.uid == resource.data.cleanerId
          && request.resource.data.cleanerUnread == 0
          && request.resource.data.customerUnread == resource.data.customerUnread + 1
          && request.resource.data.lastMessage is string
          && request.resource.data.lastMessage.size() <= 2000
          && request.resource.data.lastMessageAt is timestamp)
          || (request.auth.uid == resource.data.customerId
            && request.resource.data.customerUnread == 0
            && request.resource.data.cleanerUnread == resource.data.cleanerUnread
            && request.resource.data.lastMessage == resource.data.lastMessage
            && request.resource.data.lastMessageAt == resource.data.lastMessageAt)
          || (request.auth.uid == resource.data.cleanerId
            && request.resource.data.cleanerUnread == 0
            && request.resource.data.customerUnread == resource.data.customerUnread
            && request.resource.data.lastMessage == resource.data.lastMessage
            && request.resource.data.lastMessageAt == resource.data.lastMessageAt));
      allow create, delete: if false;
      match /events/{eventId} {
        allow read: if isAdmin() || (isAuth() && (get(/databases/$(database)/documents/jobs/$(jobId)).data.customerId == request.auth.uid || get(/databases/$(database)/documents/jobs/$(jobId)).data.cleanerId == request.auth.uid));
        allow write: if false;
      }
    }
    // Cleaner discovery feed contains only fields safe to show before assignment;
    // exact service address, customer identity and contact details stay in jobs.
    match /openJobs/{jobId} {
      allow read: if cleanerIsApproved();
      allow create, update, delete: if false;
    }
    match /bids/{bidId} {
      allow read: if isAdmin() || (isAuth() && (
        resource.data.cleanerId == request.auth.uid
        || get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.customerId == request.auth.uid
      ));
      allow write: if false;
    }

    // ───────────────────────── messages ─────────────────────────
    // Chat unlocks the instant a bid is accepted, not before: the sender must
    // be a participant on the job AND the job must be assigned (i.e.
    // acceptBid has run and set cleanerId) — a real server-side guarantee,
    // not just a client-side convention.
    match /messages/{msgId} {
      allow read: if isAdmin() || isJobParticipant(resource.data.jobId);
      allow create: if isAuth()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.keys().hasOnly(['jobId','senderId','senderName','text','imageUrl','createdAt'])
        && isJobParticipant(request.resource.data.jobId)
        && get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.status in ['ASSIGNED','EN_ROUTE','IN_PROGRESS','COMPLETED']
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        && (!('imageUrl' in request.resource.data) || request.resource.data.imageUrl.matches('https://firebasestorage.googleapis.com/.*'));
      allow update, delete: if false;
    }

    // ───────────────────────── reviews ─────────────────────────
    // Written only by the submitRating function.
    match /reviews/{reviewId} {
      allow read: if isAdmin() || isAuth();
      allow create: if false;
      allow update, delete: if false;
    }

    // ───────────────────────── agreement logs ─────────────────────────
    match /agreement_logs/{logId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ───────────────────────── disputes ─────────────────────────
    // Filed and resolved through validated server functions.
    match /disputes/{disputeId} {
      allow read: if isAdmin() || (isAuth() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.cleanerId == request.auth.uid
      ));
      allow create: if false;
      allow update, delete: if false;
    }

    // ───────────────────────── invoices ─────────────────────────
    match /invoices/{invoiceId} {
      allow read: if isAuth() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.cleanerId == request.auth.uid
      );
      allow write: if false; // Cloud Functions only
    }

    // ───────────────────────── favorites ─────────────────────────
    // A customer's saved cleaners, for quick rebooking. No money/trust fields
    // involved, so plain client writes are safe — scoped to the caller's own docs.
    match /favorites/{favoriteId} {
      allow read: if isAuth() && resource.data.customerId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.customerId == request.auth.uid;
      allow delete: if isAuth() && resource.data.customerId == request.auth.uid;
      allow update: if false;
    }

    // Organization membership and invitations are managed by callable Functions.
    match /organizations/{organizationId} {
      allow read: if isAuth() && resource.data.ownerId == request.auth.uid;
      allow write: if false;
    }
    match /organizationMembers/{memberId} {
      allow read: if isAuth() && (
        resource.data.cleanerId == request.auth.uid ||
        get(/databases/$(database)/documents/organizations/$(resource.data.organizationId)).data.ownerId == request.auth.uid
      );
      allow write: if false;
    }
    match /organizationInvites/{inviteId} {
      allow read: if isAuth() && resource.data.organizationId == request.auth.uid;
      allow write: if false;
    }

    // ───────────────────────── notifications ─────────────────────────
    // Written exclusively by Cloud Functions triggers (new bid, job status
    // change, new message). Clients may only flip their own `read` flag.
    match /notifications/{notificationId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow update: if isAuth()
        && resource.data.userId == request.auth.uid
        && !changed(['userId', 'type', 'title', 'body', 'jobId', 'createdAt']);
      allow create, delete: if false;
    }

    match /configuration/{document} { allow read: if isAdmin(); allow write: if false; }
    match /reviewCases/{caseId} { allow read: if isAdmin(); allow write: if false; }
    match /supportCases/{caseId} { allow read: if isAdmin(); allow write: if false; }
    match /payments/{paymentId} { allow read: if isAdmin() || (isAuth() && resource.data.customerId == request.auth.uid); allow write: if false; }
    match /refunds/{refundId} { allow read: if isAdmin() && hasPermission('finance.read'); allow write: if false; }
    match /adminAuditEvents/{eventId} { allow read: if isAdmin() && hasPermission('audit.read'); allow write: if false; }
    match /reportingAggregates/{aggregateId} { allow read, write: if false; }
    match /products/{productId} { allow read: if isAuth(); allow write: if false; }
    match /productSales/{saleId} { allow read: if isAdmin(); allow write: if false; }
    match /cleanerInventory/{inventoryId} { allow read: if isAdmin() || (isAuth() && resource.data.cleanerId == request.auth.uid); allow write: if false; }

    // Deny everything else
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
