rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // Keys that change when an update touches any of the listed fields.
    function changed(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ───────────────────────── users ─────────────────────────
    // Anyone signed in can READ a profile (cleaner name/rating on bid cards).
    // A user may only write their OWN document, and may NEVER set or change the
    // money / trust fields — those are owned exclusively by Cloud Functions
    // (settlement, rating aggregation, admin moderation) via the Admin SDK.
    match /users/{userId} {
      allow read: if isAuth();

      allow create: if isOwner(userId)
        && request.resource.data.balance == 0
        && (!('jobsCompleted' in request.resource.data) || request.resource.data.jobsCompleted == 0)
        && (!('ratingAverage' in request.resource.data) || request.resource.data.ratingAverage == 0)
        && (!('ratingCount' in request.resource.data) || request.resource.data.ratingCount == 0)
        && (!('isSuspended' in request.resource.data) || request.resource.data.isSuspended == false)
        && (!('isBanned' in request.resource.data) || request.resource.data.isBanned == false);

      allow update: if isOwner(userId)
        && !changed([
          'balance', 'jobsCompleted', 'ratingAverage', 'ratingCount',
          'commissionOwed', 'isSuspended', 'isBanned', 'verificationLevel',
          'uid', 'email'
        ]);

      allow delete: if false;
    }

    // ───────────────────────── transactions ─────────────────────────
    // Immutable ledger. Read your own only. ALL writes happen server-side
    // (settlement, PesePay webhook). Clients can never create or edit a record.
    match /transactions/{txId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ───────────────────────── jobs ─────────────────────────
    // Customer creates; customer + assigned cleaner read and make limited updates
    // (status transitions, cleaner location). Money / identity fields (price,
    // customerBid, payment, rating, the party ids) are function-only.
    match /jobs/{jobId} {
      allow read: if isAuth() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.cleanerId == request.auth.uid ||
        resource.data.status == 'BIDDING'
      );

      allow create: if isAuth()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'BIDDING'
        && !('cleanerId' in request.resource.data)
        && !('price' in request.resource.data)
        && !('paidAt' in request.resource.data);

      allow update: if isAuth()
        && (
          resource.data.customerId == request.auth.uid ||
          resource.data.cleanerId == request.auth.uid
        )
        && !changed([
          'price', 'customerBid', 'paidAt', 'paymentMethod', 'rating', 'ratedAt',
          'customerId', 'cleanerId', 'cleanerName', 'cleanerPhoto', 'cleanerRating'
        ]);

      allow delete: if false;
    }

    // ───────────────────────── bids ─────────────────────────
    // A cleaner creates a bid for themselves. Acceptance / rejection is done by
    // the acceptBid Cloud Function (which also sets the authoritative price), so
    // clients can never mutate a bid after creation.
    match /bids/{bidId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.cleanerId == request.auth.uid;
      allow update, delete: if false;
    }

    // ───────────────────────── messages ─────────────────────────
    match /messages/{msgId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if false;
    }

    // ───────────────────────── reviews ─────────────────────────
    // Written by the submitRating function so the rating average stays authoritative.
    match /reviews/{reviewId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // ───────────────────────── agreement logs ─────────────────────────
    match /agreement_logs/{logId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ───────────────────────── invoices ─────────────────────────
    match /invoices/{invoiceId} {
      allow read: if isAuth() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.cleanerId == request.auth.uid
      );
      allow write: if false; // Cloud Functions only
    }

    // Deny everything else
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
