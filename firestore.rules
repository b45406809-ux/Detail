rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // Keys that change when an update touches any of the listed fields.
    function changed(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ───────────────────────── users ─────────────────────────
    // Anyone signed in can READ a profile (cleaner name/rating on bid cards).
    // A user may only write their OWN document, and may NEVER set or change the
    // money / trust fields — those are owned exclusively by Cloud Functions
    // (settlement, rating aggregation, admin moderation) via the Admin SDK.
    match /users/{userId} {
      allow read: if isAuth();

      allow create: if isOwner(userId)
        && request.resource.data.balance == 0
        && (!('jobsCompleted' in request.resource.data) || request.resource.data.jobsCompleted == 0)
        && (!('ratingAverage' in request.resource.data) || request.resource.data.ratingAverage == 0)
        && (!('ratingCount' in request.resource.data) || request.resource.data.ratingCount == 0)
        && (!('isSuspended' in request.resource.data) || request.resource.data.isSuspended == false)
        && (!('isBanned' in request.resource.data) || request.resource.data.isBanned == false);

      allow update: if isOwner(userId)
        && !changed([
          'balance', 'jobsCompleted', 'ratingAverage', 'ratingCount',
          'commissionOwed', 'isSuspended', 'isBanned', 'verificationLevel',
          'uid', 'email'
        ]);

      allow delete: if false;
    }

    // ───────────────────────── transactions ─────────────────────────
    // Immutable ledger. Read your own only. ALL writes happen server-side
    // (settlement, PesePay webhook). Clients can never create or edit a record.
    match /transactions/{txId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ───────────────────────── jobs ─────────────────────────
    // Customer creates; customer + assigned cleaner read and make limited updates
    // (status transitions, cleaner location). Money / identity fields (price,
    // customerBid, payment, rating, the party ids) are function-only.
    match /jobs/{jobId} {
      allow read: if isAuth() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.cleanerId == request.auth.uid ||
        resource.data.status == 'BIDDING'
      );

      allow create: if isAuth()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'BIDDING'
        && !('cleanerId' in request.resource.data)
        && !('price' in request.resource.data)
        && !('paidAt' in request.resource.data);

      allow update: if isAuth()
        && (
          resource.data.customerId == request.auth.uid ||
          resource.data.cleanerId == request.auth.uid
        )
        && !changed([
          'price', 'paidAt', 'paymentMethod', 'rating', 'ratedAt',
          'customerId', 'cleanerId', 'cleanerName', 'cleanerPhoto', 'cleanerRating',
          // budget/biddingExpiresAt only ever change via the increaseJobBudget
          // Cloud Function (which also extends the window) — never a raw client write.
          'budget', 'biddingExpiresAt'
        ]);

      allow delete: if false;
    }

    // ───────────────────────── bids ─────────────────────────
    // Created exclusively by the submitBid Cloud Function, which enforces the
    // cash-commission balance gate (negative balance = blocked from bidding)
    // authoritatively — a client-side check alone couldn't be trusted.
    // Acceptance is done by the acceptBid Cloud Function (which also sets the
    // authoritative price), so clients can never mutate a bid after creation.
    match /bids/{bidId} {
      allow read: if isAuth();
      allow create: if false;

      // Rejecting a bid moves no money, so the job's customer may do it
      // directly — acceptance/price changes stay server-only (acceptBid).
      allow update: if isAuth()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'REJECTED'
        && resource.data.status in ['PENDING', 'COUNTERED']
        && get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.customerId == request.auth.uid;

      allow delete: if false;
    }

    // ───────────────────────── messages ─────────────────────────
    // Chat unlocks the instant a bid is accepted, not before: the sender must
    // be a participant on the job AND the job must have left BIDDING (i.e.
    // acceptBid has run and set cleanerId) — a real server-side guarantee,
    // not just a client-side convention.
    match /messages/{msgId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.senderId == request.auth.uid
        && get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.status != 'BIDDING'
        && (
          get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.customerId == request.auth.uid ||
          get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.cleanerId == request.auth.uid
        );
      allow update, delete: if false;
    }

    // ───────────────────────── reviews ─────────────────────────
    // Written by the submitRating function so the rating average stays authoritative.
    match /reviews/{reviewId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // ───────────────────────── agreement logs ─────────────────────────
    match /agreement_logs/{logId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ───────────────────────── invoices ─────────────────────────
    match /invoices/{invoiceId} {
      allow read: if isAuth() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.cleanerId == request.auth.uid
      );
      allow write: if false; // Cloud Functions only
    }

    // ───────────────────────── favorites ─────────────────────────
    // A customer's saved cleaners, for quick rebooking. No money/trust fields
    // involved, so plain client writes are safe — scoped to the caller's own docs.
    match /favorites/{favoriteId} {
      allow read: if isAuth() && resource.data.customerId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.customerId == request.auth.uid;
      allow delete: if isAuth() && resource.data.customerId == request.auth.uid;
      allow update: if false;
    }

    // ───────────────────────── notifications ─────────────────────────
    // Written exclusively by Cloud Functions triggers (new bid, job status
    // change, new message). Clients may only flip their own `read` flag.
    match /notifications/{notificationId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow update: if isAuth()
        && resource.data.userId == request.auth.uid
        && !changed(['userId', 'type', 'title', 'body', 'jobId', 'createdAt']);
      allow create, delete: if false;
    }

    // Deny everything else
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
