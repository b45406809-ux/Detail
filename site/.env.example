# The marketing site and dashboard use the Cloudflare Worker; Firebase is mobile-only.
# Optional privacy-gated analytics
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Optional Cloudflare Turnstile public site key. Secret is configured on the waitlist Worker.
VITE_TURNSTILE_SITE_KEY=
# Public Cloudflare Worker URL created by scripts/deploy-cloudflare-waitlist.py
VITE_WAITLIST_API_URL=https://detail-waitlist.example.workers.dev
# Public deployment URLs (documentation/links; no secrets)
VITE_SITE_URL=https://detailapp.co.zw
VITE_DASHBOARD_URL=https://dashboard.detailapp.co.zw
