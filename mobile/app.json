{
  "expo": {
    "name": "Detail",
    "slug": "detail",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "detail",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#3906d2"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.detail.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Detail uses your location to find nearby cleaners.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Detail tracks your location during active jobs.",
        "NSMicrophoneUsageDescription": "Detail uses the microphone for calls with cleaners.",
        "NSCameraUsageDescription": "Detail uses the camera to take job photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3906d2"
      },
      "package": "com.detail.app",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Detail uses your photos so cleaners can see the space or vehicle before bidding.",
          "cameraPermission": "Detail uses the camera to take job photos."
        }
      ],
      [
        "expo-font",
        {
          "fonts": []
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Detail to use your location to find cleaners nearby.",
          "locationWhenInUsePermission": "Allow Detail to use your location."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#3906d2",
          "sounds": []
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "560c0183-2f37-4d7a-8e4f-59b9b0bf9e85"
      }
    },
    "owner": "detail-test"
  }
}
