{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "env": { "EXPO_PUBLIC_APP_BUILD_PROFILE": "development" },
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "env": { "EXPO_PUBLIC_APP_BUILD_PROFILE": "preview" },
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "env": { "EXPO_PUBLIC_APP_BUILD_PROFILE": "production" },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": { "buildConfiguration": "Release" },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": { "ios": {}, "android": {} }
  }
}
