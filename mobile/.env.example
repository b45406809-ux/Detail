# Firebase Configuration
# Copy this file to .env.local and fill in your values.
# All EXPO_PUBLIC_* variables are bundled into the client app.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=

# If you use a named Firestore database (not "(default)")
EXPO_PUBLIC_FIRESTORE_DATABASE_ID=

# Stripe — production publishable key (pk_live_...)
# Leave empty in dev; the app uses a simulated payment flow when __DEV__ is true.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
