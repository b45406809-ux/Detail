EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
# EAS sets EXPO_PUBLIC_APP_BUILD_PROFILE from eas.json; do not override for production builds.
# Optional genuine OTP/auth testing from Metro; must point to an isolated Supabase staging project.
EXPO_PUBLIC_USE_STAGING_AUTH=false
EXPO_PUBLIC_STAGING_SUPABASE_URL=https://your-staging-project.supabase.co
EXPO_PUBLIC_STAGING_SUPABASE_ANON_KEY=your-staging-publishable-or-anon-key
# Optional isolated backend for default mock mode or EXPO_PUBLIC_DEMO_MODE=true.
# If omitted, mock builds use local Supabase at http://127.0.0.1:54321.
EXPO_PUBLIC_MOCK_SUPABASE_URL=
EXPO_PUBLIC_MOCK_SUPABASE_ANON_KEY=
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your-public-token
# Set MAPBOX_DOWNLOADS_TOKEN as an EAS secret (DOWNLOADS:READ scope); do not put it in the client .env.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
