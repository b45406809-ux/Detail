# Firebase Configuration
# Copy this file to .env.local and fill in your values.
# All EXPO_PUBLIC_* variables are bundled into the client app.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=

# If you use a named Firestore database (not "(default)")
EXPO_PUBLIC_FIRESTORE_DATABASE_ID=

# PesePay — payments are processed server-side (Firebase Cloud Functions).
# The integration key and encryption key must ONLY live on the backend (never in the app).
# No client-side PesePay key is needed here — the app calls Cloud Functions which hold the secrets.
# Set them as Cloud Functions secrets (not here):
#   firebase functions:secrets:set PESEPAY_INTEGRATION_KEY
#   firebase functions:secrets:set PESEPAY_ENCRYPTION_KEY

# Local development against the Firebase emulators.
# When 'true', the app talks to your local emulator suite (auth:9099, firestore:8080,
# functions:5001) so DEV runs the real server code & security rules — no client-side
# money writes. Start them with: firebase emulators:start
# On a physical device, set EMULATOR_HOST to your computer's LAN IP (e.g. 192.168.1.20).
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=false
EXPO_PUBLIC_EMULATOR_HOST=localhost
