diff --git a/node_modules/react-native/ReactCommon/react/debug/react_native_assert.h b/node_modules/react-native/ReactCommon/react/debug/react_native_assert.h
index 1d399d4..3595290 100644
--- a/node_modules/react-native/ReactCommon/react/debug/react_native_assert.h
+++ b/node_modules/react-native/ReactCommon/react/debug/react_native_assert.h
@@ -51,21 +51,16 @@ void react_native_assert_fail(
 
 #else // __ANDROID__
 
-#include <glog/logging.h>
 #include <cassert>
 
-// For all platforms, but iOS+Xcode especially: flush logs because some might be
-// lost on iOS if an assert is hit right after this. If you are trying to debug
-// something actively and have added lots of LOG statements to track down an
-// issue, there is race between flushing the final logs and stopping execution
-// when the assert hits. Thus, if we know an assert will fail, we force flushing
-// to happen right before the assert.
-#define react_native_assert(cond)                           \
-  if (!(cond)) {                                            \
-    LOG(ERROR) << "react_native_assert failure: " << #cond; \
-    google::FlushLogFiles(google::GLOG_INFO);               \
-    assert(cond);                                           \
-  }
+// Keep this assertion header independent of glog so it can be imported as a
+// Clang module. `assert` still reports the failed condition and stops execution.
+#define react_native_assert(cond) \
+  do { \
+    if (!(cond)) { \
+      assert(cond); \
+    } \
+  } while (0)
 
 #endif // platforms besides __ANDROID__
 
diff --git a/node_modules/react-native/third-party-podspecs/RCT-Folly.podspec b/node_modules/react-native/third-party-podspecs/RCT-Folly.podspec
index c3e095f..b6c93fa 100644
--- a/node_modules/react-native/third-party-podspecs/RCT-Folly.podspec
+++ b/node_modules/react-native/third-party-podspecs/RCT-Folly.podspec
@@ -95,6 +95,11 @@ Pod::Spec.new do |spec|
                                "DEFINES_MODULE" => "YES",
                                "CLANG_CXX_LANGUAGE_STANDARD" => rct_cxx_language_standard(),
                                "HEADER_SEARCH_PATHS" => "\"$(PODS_TARGET_SRCROOT)\" \"$(PODS_ROOT)/boost\" \"$(PODS_ROOT)/DoubleConversion\" \"$(PODS_ROOT)/fast_float/include\" \"$(PODS_ROOT)/fmt/include\"",
+                               # Folly's generated config header is not part of the CocoaPods source tree.
+                               # NitroModules imports Folly headers as a Clang module, so make the same
+                               # no-generated-config mode available while Xcode builds that module.
+                               "GCC_PREPROCESSOR_DEFINITIONS" => "$(inherited) FOLLY_NO_CONFIG=1 FOLLY_CFG_NO_COROUTINES=1",
+                               "OTHER_CPLUSPLUSFLAGS" => "$(inherited) -DFOLLY_NO_CONFIG=1 -DFOLLY_CFG_NO_COROUTINES=1",
                                # In dynamic framework (use_frameworks!) mode, ignore the unused and undefined boost symbols when generating the library.
                                "OTHER_LDFLAGS" => "\"-Wl,-U,_jump_fcontext\" \"-Wl,-U,_make_fcontext\""
                              }
